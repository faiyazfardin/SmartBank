{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_NEON_HOST;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SUPER_SECRET_KEY_MINIMUM_32_CHARS!",
    "Issuer": "SmartBankAPI",
    "Audience": "SmartBankClient",
    "ExpiryMinutes": 43200,
    "RefreshTokenExpiryDays": 90
  },
  "Security": {
    "MaxLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RateLimitAttempts": 5,
    "RateLimitPeriodMinutes": 15
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    }
  },
  "Email": {
    "SenderEmail": "security@smartbank.com",
    "SenderName": "SmartBank Security"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "YOUR_SMTP_FROM_EMAIL",
    "FromName": "SmartBank Digital"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}