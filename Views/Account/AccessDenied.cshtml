@{
    ViewData["Title"] = "Access Restricted";
}

<div class="auth-wrapper">
    <div class="auth-card text-center" style="max-width: 520px;">
        <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle shadow-sm mb-3" style="width: 76px; height: 76px; font-size: 2.5rem;">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Access Restricted</h3>
        <p class="text-muted mb-4">
            You do not have administrative privileges to access this area. If you need to access the Admin Command Center, please log in using an authorized administrator account.
        </p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mb-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark px-3 py-2 fw-semibold rounded-pill">
                <i class="bi bi-house-door me-1"></i> Home Page
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-3 py-2 fw-semibold rounded-pill">
                <i class="bi bi-grid-fill me-1"></i> User Dashboard
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-danger px-3 py-2 fw-semibold rounded-pill">
                <i class="bi bi-box-arrow-right me-1"></i> Sign Out / Switch User
            </a>
        </div>

        <div class="small text-muted bg-light p-2 rounded-3 border">
            Need admin access? Click <strong>Sign Out / Switch User</strong> above and sign in with the Admin credentials.
        </div>
    </div>
</div>
