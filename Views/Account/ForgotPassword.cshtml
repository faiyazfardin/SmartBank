@model SmartBank.ViewModels.ForgotPasswordRequestViewModel
@{
    ViewData["Title"] = "Forgot Password — SmartBank";
}

<div class="auth-wrapper">
    <div class="auth-card-pro">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-icon-box mx-auto mb-3 shadow-glow" style="width: 52px; height: 52px; font-size: 1.5rem; background: rgba(14, 165, 233, 0.15); border: 1px solid rgba(14, 165, 233, 0.3);">
                <i class="bi bi-key-fill text-info"></i>
            </div>
            <h2 class="fw-extrabold text-white mb-1 tracking-tight">Forgot Password?</h2>
            <p class="text-secondary small mb-0">Enter your account username to receive a security verification code.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger alert-dismissible fade show d-flex align-items-center mb-4 rounded-3" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                <div class="small fw-semibold">@ViewBag.Error</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="fpForm">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="form-label fw-semibold small text-light opacity-90 mb-1">Username</label>
                <div class="input-group auth-input-group">
                    <span class="input-group-text"><i class="bi bi-person text-info"></i></span>
                    <input type="text" asp-for="Username" class="form-control" placeholder="Enter your username" required autofocus />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <button type="submit" id="submitFpBtn" class="btn-cta-primary w-100 py-2-5 fw-bold shadow-glow mb-3">
                <i class="bi bi-send-fill me-2"></i> Send Verification Code
            </button>
        </form>

        <div class="text-center pt-3 border-top border-secondary border-opacity-20">
            <a asp-controller="Account" asp-action="Login" class="text-secondary small text-decoration-none fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Remember password? Back to Login
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const fpForm = document.getElementById('fpForm');
        const fpBtn = document.getElementById('submitFpBtn');

        if (fpForm) {
            fpForm.addEventListener('submit', function (e) {
                if (window.jQuery && typeof $(fpForm).valid === 'function') {
                    if (!$(fpForm).valid()) {
                        return false;
                    }
                }

                if (fpBtn && !fpBtn.disabled) {
                    fpBtn.disabled = true;
                    fpBtn.style.pointerEvents = 'none';
                    fpBtn.style.opacity = '0.85';
                    fpBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';
                }
            });
        }
    </script>
}
