@{
    ViewData["Title"] = "Verify Email — SmartBank";
    var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "your email address";
}

<div class="auth-wrapper">
    <div class="auth-card-pro">
        <div class="text-center mb-4">
            <div class="brand-icon-box mx-auto mb-3 shadow-glow" style="width: 56px; height: 56px; font-size: 1.6rem; background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.4);">
                <i class="bi bi-shield-lock-fill text-info"></i>
            </div>
            <h3 class="fw-extrabold text-white mb-1">Verify Your Email</h3>
            <p class="text-secondary small mb-0">Enter the 6-digit verification code sent to your registered email</p>
        </div>

        @if (TempData["SuccessToast"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-10 border border-success border-opacity-30 text-success alert-dismissible fade show d-flex align-items-center mb-4 rounded-3" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div class="small fw-semibold">@TempData["SuccessToast"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger alert-dismissible fade show d-flex align-items-center mb-4 rounded-3" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                <div class="small fw-semibold">@ViewBag.Error</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="p-3 rounded-3 mb-4 text-center" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1);">
            <div class="small text-secondary mb-1">Verification code sent to</div>
            <div class="fw-bold text-white fs-6 font-monospace">@userEmail</div>
            <div class="small text-warning mt-1"><i class="bi bi-clock-history me-1"></i> Code valid for 5 minutes</div>
        </div>

        <form asp-controller="Account" asp-action="VerifyEmail" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="form-label fw-semibold small text-light opacity-90 mb-1">6-Digit Verification Code</label>
                <div class="input-group auth-input-group">
                    <span class="input-group-text"><i class="bi bi-key-fill text-warning"></i></span>
                    <input type="text" name="otp" class="form-control text-center fs-4 fw-bold font-monospace letter-spacing-2" placeholder="••••••" maxlength="6" pattern="[0-9]{6}" required autofocus />
                </div>
            </div>

            <button type="submit" class="btn-cta-primary w-100 py-2-5 fw-bold shadow-glow mb-3">
                <i class="bi bi-check2-circle me-2"></i> Verify Email Address
            </button>
        </form>

        <form asp-controller="Account" asp-action="ResendEmailVerificationOtp" method="post" class="text-center">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link text-secondary text-decoration-none small">
                <i class="bi bi-arrow-clockwise me-1"></i> Didn't receive code? Resend OTP
            </button>
        </form>
    </div>
</div>
