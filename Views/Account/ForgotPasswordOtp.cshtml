@{
    ViewData["Title"] = "Verify Reset Code — SmartBank";
    var maskedEmail = ViewBag.MaskedEmail as string ?? "your email";
    var resendCount = ViewBag.ResendCount is int count ? count : 0;
}

<div class="auth-wrapper py-5">
    <div class="auth-card-pro" style="max-width: 480px; border-radius: 24px; padding: 2.5rem 2rem; background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);">
        
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle shadow-glow mb-3" style="background: rgba(14, 165, 233, 0.15); border: 1px solid rgba(14, 165, 233, 0.3); width: 64px; height: 64px;">
                <i class="bi bi-shield-lock text-info fs-2"></i>
            </div>
            <h4 class="fw-bold text-white mb-1">Verify Password Reset OTP</h4>
            <p class="text-secondary small mb-0">An OTP has been sent to <br /><strong class="text-info font-monospace">@maskedEmail</strong></p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger small rounded-3 mb-3 d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-6 flex-shrink-0"></i>
                <div>@ViewBag.Error</div>
            </div>
        }

        <div id="resendAlert" class="alert alert-success bg-success bg-opacity-10 border border-success border-opacity-25 text-success small rounded-3 mb-3 d-none align-items-center">
            <i class="bi bi-check-circle-fill me-2 fs-6 flex-shrink-0"></i>
            <div id="resendAlertText">New code sent!</div>
        </div>

        <form asp-action="ForgotPasswordVerifyOtp" method="post" id="otpForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="code" id="hiddenOtpCode" value="" />

            <!-- 6 Individual OTP Boxes -->
            <div class="d-flex justify-content-between gap-2 mb-4">
                @for (int i = 0; i < 6; i++)
                {
                    <input type="text" 
                           class="form-control text-center font-monospace otp-digit" 
                           maxlength="1" 
                           inputmode="numeric" 
                           data-index="@i" />
                }
            </div>

            <button type="submit" class="btn btn-cta-primary w-100 py-3 rounded-3 shadow-sm mb-3" id="btnSubmitOtp">
                Verify OTP Code <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </form>

        <div class="d-flex justify-content-between align-items-center pt-2">
            <span id="countdownText" class="small text-secondary">Code valid for <strong id="timerSec" class="text-white">300</strong>s</span>
            @if (resendCount < 3)
            {
                <button type="button" id="btnResend" class="btn btn-link text-info text-decoration-none small fw-semibold p-0 d-none" onclick="triggerResend()">
                    Resend Code (<span id="resendCountText">@resendCount</span>/3)
                </button>
            }
            else
            {
                <span class="small text-muted">Max resends reached (3/3)</span>
            }
        </div>

        <div class="text-center pt-4 mt-3 border-top border-secondary border-opacity-20">
            <a asp-action="Login" class="text-secondary small text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Cancel &amp; Back to Login
            </a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const inputs = document.querySelectorAll('.otp-digit');
        const hiddenCode = document.getElementById('hiddenOtpCode');
        const form = document.getElementById('otpForm');
        let isFormSubmitting = false;

        if (inputs.length > 0) inputs[0].focus();

        inputs.forEach((input, idx) => {
            input.addEventListener('input', (e) => {
                const val = e.target.value.replace(/\D/g, '');
                e.target.value = val ? val[0] : '';
                if (val && idx < inputs.length - 1) {
                    inputs[idx + 1].focus();
                }
                syncOtpAndCheck();
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && idx > 0) {
                    inputs[idx - 1].focus();
                }
            });

            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
                if (pasteData) {
                    for (let i = 0; i < inputs.length; i++) {
                        inputs[i].value = pasteData[i] || '';
                    }
                    syncOtpAndCheck();
                }
            });
        });

        function syncOtpAndCheck() {
            let fullCode = '';
            inputs.forEach(i => fullCode += i.value);
            hiddenCode.value = fullCode;
            if (fullCode.length === 6 && !isFormSubmitting) {
                submitOtpForm();
            }
        }

        function submitOtpForm() {
            if (isFormSubmitting) return;
            isFormSubmitting = true;
            const btn = document.getElementById('btnSubmitOtp');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Verifying...';
            }
            form.submit();
        }

        if (form) {
            form.addEventListener('submit', (e) => {
                let fullCode = '';
                inputs.forEach(i => fullCode += i.value);
                hiddenCode.value = fullCode;

                if (fullCode.length !== 6) {
                    e.preventDefault();
                    alert('Please enter all 6 digits of the OTP code.');
                    return false;
                }

                if (isFormSubmitting) {
                    e.preventDefault();
                    return false;
                }
                isFormSubmitting = true;
                const btn = document.getElementById('btnSubmitOtp');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Verifying...';
                }
            });
        }

        // 5-Minute (300-Second) Expiry Timer
        let seconds = 300;
        const timerSpan = document.getElementById('timerSec');
        const countdownText = document.getElementById('countdownText');
        const resendBtn = document.getElementById('btnResend');

        const interval = setInterval(() => {
            seconds--;
            if (timerSpan) timerSpan.textContent = seconds;
            if (seconds <= 240 && resendBtn && resendBtn.classList.contains('d-none')) {
                // Allow resend after 60s cooldown
                resendBtn.classList.remove('d-none');
            }
            if (seconds <= 0) {
                clearInterval(interval);
                if (countdownText) countdownText.innerHTML = '<span class="text-danger fw-semibold"><i class="bi bi-clock-history me-1"></i> Code Expired. Please request a new code.</span>';
            }
        }, 1000);
    });

    async function triggerResend() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        const resendAlert = document.getElementById('resendAlert');
        const resendAlertText = document.getElementById('resendAlertText');

        try {
            const resp = await fetch('/Account/ForgotPasswordResendOtp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                }
            });
            const data = await resp.json();
            if (data.success) {
                resendAlert.classList.remove('d-none');
                resendAlert.classList.add('d-flex');
                resendAlertText.textContent = data.message;
                if (data.resendCount !== undefined) {
                    const cntSpan = document.getElementById('resendCountText');
                    if (cntSpan) cntSpan.textContent = data.resendCount;
                    if (data.resendCount >= 3) {
                        const resendBtn = document.getElementById('btnResend');
                        if (resendBtn) resendBtn.remove();
                    }
                }
            } else {
                alert(data.message);
            }
        } catch (e) {
            alert('Could not resend OTP. Please try again.');
        }
    }
</script>
