@{
    ViewData["Title"] = "Change Password — SmartBank";
    var isForced = ViewBag.IsForced == true;
}

<div class="auth-wrapper py-5">
    <div class="auth-card-pro" style="max-width: 480px; border-radius: 24px; padding: 2.5rem 2rem; background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);">
        
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle shadow-glow mb-3" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); width: 64px; height: 64px;">
                <i class="bi bi-key-fill text-warning fs-2"></i>
            </div>
            <h4 class="fw-bold text-white mb-1">Set New Permanent Password</h4>
            @if (isForced)
            {
                <p class="text-warning small mb-0">For security reasons, you MUST update your temporary password before proceeding.</p>
            }
            else
            {
                <p class="text-secondary small mb-0">Choose a strong permanent password for your SmartBank account.</p>
            }
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger small rounded-3 mb-3 d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-6 flex-shrink-0"></i>
                <div>@ViewBag.Error</div>
            </div>
        }

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="forced" value="@(isForced ? "true" : "false")" />

            <div class="mb-3">
                <label class="form-label small fw-semibold text-light opacity-90 mb-1">New Password *</label>
                <div class="input-group auth-input-group">
                    <span class="input-group-text"><i class="bi bi-lock text-info"></i></span>
                    <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required autofocus minlength="8" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-light opacity-90 mb-1">Confirm New Password *</label>
                <div class="input-group auth-input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill text-warning"></i></span>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required minlength="8" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-glow mb-3 rounded-3">
                Update Password &amp; Continue <i class="bi bi-shield-check ms-1"></i>
            </button>
        </form>
    </div>
</div>
