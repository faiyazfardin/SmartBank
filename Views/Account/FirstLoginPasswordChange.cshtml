@model SmartBank.ViewModels.FirstLoginPasswordChangeViewModel
@{
    ViewData["Title"] = "Mandatory Security Setup — First Login";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">
            <!-- Header Card -->
            <div class="sb-card p-4 p-md-5 mb-4 text-center position-relative overflow-hidden shadow-lg">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle p-3 mb-3" style="background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.35);">
                    <i class="bi bi-shield-lock-fill fs-1 text-info"></i>
                </div>
                <h2 class="fw-bold text-white mb-2">First-Time Security Activation</h2>
                <p class="text-muted mx-auto mb-0" style="max-width: 680px;">
                    Welcome to <strong>SmartBank Digital</strong>. To protect your financial assets, our compliance protocol requires you to establish your personalized <strong>Account Login Password</strong> and <strong>Security Vault Password</strong> before accessing your dashboard.
                </p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-md mb-4" role="alert" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4) !important; color: #fecdd3;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <h6 class="fw-bold mb-0">Password Validation Errors</h6>
                    </div>
                    <ul class="mb-0 mt-2 small">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-md mb-4" role="alert" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4) !important; color: #fecdd3;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-controller="Account" asp-action="FirstLoginPasswordChange" method="post" id="firstLoginForm">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <!-- Column 1: Account Login Password -->
                    <div class="col-md-6">
                        <div class="sb-card p-4 h-100 shadow-md border-top border-primary border-3">
                            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary-subtle">
                                <span class="badge bg-primary bg-gradient rounded-pill px-3 py-1">Step 1</span>
                                <h5 class="fw-bold text-white mb-0">Account Login Password</h5>
                            </div>
                            <p class="small text-muted mb-4">
                                Used for day-to-day login to your online banking portal and dashboard.
                            </p>

                            <div class="mb-3">
                                <label asp-for="CurrentAccountPassword" class="form-label small fw-semibold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-key"></i></span>
                                    <input asp-for="CurrentAccountPassword" class="form-control" placeholder="Enter password from email" required />
                                </div>
                                <span asp-validation-for="CurrentAccountPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewAccountPassword" class="form-label small fw-semibold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-lock"></i></span>
                                    <input asp-for="NewAccountPassword" id="accountNewPass" class="form-control" placeholder="Minimum 8 characters" required />
                                </div>
                                <span asp-validation-for="NewAccountPassword" class="text-danger small"></span>

                                <!-- Live Strength Criteria for Account -->
                                <div class="p-2 rounded-3 mt-2 small" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.06);">
                                    <div class="d-flex align-items-center gap-2" id="accReqLen"><i class="bi bi-circle text-muted"></i> <span>At least 8 characters</span></div>
                                    <div class="d-flex align-items-center gap-2" id="accReqUpper"><i class="bi bi-circle text-muted"></i> <span>At least 1 uppercase letter (A-Z)</span></div>
                                    <div class="d-flex align-items-center gap-2" id="accReqLower"><i class="bi bi-circle text-muted"></i> <span>At least 1 lowercase letter (a-z)</span></div>
                                    <div class="d-flex align-items-center gap-2" id="accReqNum"><i class="bi bi-circle text-muted"></i> <span>At least 1 number (0-9)</span></div>
                                    <div class="d-flex align-items-center gap-2" id="accReqSpec"><i class="bi bi-circle text-muted"></i> <span>At least 1 special character (!@@#$%^&*)</span></div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmAccountPassword" class="form-label small fw-semibold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-check2-circle"></i></span>
                                    <input asp-for="ConfirmAccountPassword" id="accountConfirmPass" class="form-control" placeholder="Repeat new account password" required />
                                </div>
                                <span asp-validation-for="ConfirmAccountPassword" class="text-danger small"></span>
                                <div id="accMatchMsg" class="small mt-1 d-none"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Security Vault Password -->
                    <div class="col-md-6">
                        <div class="sb-card p-4 h-100 shadow-md border-top border-info border-3">
                            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary-subtle">
                                <span class="badge bg-info bg-gradient rounded-pill px-3 py-1 text-dark fw-bold">Step 2</span>
                                <h5 class="fw-bold text-white mb-0">Security Vault Password</h5>
                            </div>
                            <p class="small text-muted mb-4">
                                Unlocks the encrypted Vault holding your live Balance, Card details, and Transaction logs.
                            </p>

                            <div class="mb-3">
                                <label asp-for="CurrentVaultPassword" class="form-label small fw-semibold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-key-fill text-warning"></i></span>
                                    <input asp-for="CurrentVaultPassword" class="form-control" placeholder="Enter vault password (or 'password')" required />
                                </div>
                                <span asp-validation-for="CurrentVaultPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewVaultPassword" class="form-label small fw-semibold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-safe2"></i></span>
                                    <input asp-for="NewVaultPassword" id="vaultNewPass" class="form-control" placeholder="Must be different from account password" required />
                                </div>
                                <span asp-validation-for="NewVaultPassword" class="text-danger small"></span>

                                <!-- Live Strength Criteria for Vault -->
                                <div class="p-2 rounded-3 mt-2 small" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.06);">
                                    <div class="d-flex align-items-center gap-2" id="vltReqLen"><i class="bi bi-circle text-muted"></i> <span>At least 8 characters</span></div>
                                    <div class="d-flex align-items-center gap-2" id="vltReqUpper"><i class="bi bi-circle text-muted"></i> <span>At least 1 uppercase letter (A-Z)</span></div>
                                    <div class="d-flex align-items-center gap-2" id="vltReqLower"><i class="bi bi-circle text-muted"></i> <span>At least 1 lowercase letter (a-z)</span></div>
                                    <div class="d-flex align-items-center gap-2" id="vltReqNum"><i class="bi bi-circle text-muted"></i> <span>At least 1 number (0-9)</span></div>
                                    <div class="d-flex align-items-center gap-2" id="vltReqSpec"><i class="bi bi-circle text-muted"></i> <span>At least 1 special character (!@@#$%^&*)</span></div>
                                    <div class="d-flex align-items-center gap-2" id="vltReqDiff"><i class="bi bi-circle text-muted"></i> <span>Must be different from Account Password</span></div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmVaultPassword" class="form-label small fw-semibold text-secondary"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-check2-circle"></i></span>
                                    <input asp-for="ConfirmVaultPassword" id="vaultConfirmPass" class="form-control" placeholder="Repeat new vault password" required />
                                </div>
                                <span asp-validation-for="ConfirmVaultPassword" class="text-danger small"></span>
                                <div id="vltMatchMsg" class="small mt-1 d-none"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Action Footer -->
                <div class="sb-card p-4 mt-4 shadow-lg text-center">
                    <button type="submit" id="btnSubmitPasswords" class="btn btn-sb-primary btn-lg rounded-pill px-5 fw-bold shadow-glow">
                        <i class="bi bi-check-circle-fill me-2"></i> Save &amp; Activate Banking Security
                    </button>
                    <div class="text-muted small mt-2">
                        <i class="bi bi-info-circle me-1"></i> You will be redirected directly to your Customer Dashboard upon verification.
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const accPass = document.getElementById("accountNewPass");
            const accConf = document.getElementById("accountConfirmPass");
            const accMatch = document.getElementById("accMatchMsg");

            const vltPass = document.getElementById("vaultNewPass");
            const vltConf = document.getElementById("vaultConfirmPass");
            const vltMatch = document.getElementById("vltMatchMsg");

            function checkStrength(val) {
                return {
                    len: val.length >= 8,
                    upper: /[A-Z]/.test(val),
                    lower: /[a-z]/.test(val),
                    num: /[0-9]/.test(val),
                    spec: /[^A-Za-z0-9]/.test(val)
                };
            }

            function updateUI(reqId, passed) {
                const el = document.getElementById(reqId);
                if (!el) return;
                const icon = el.querySelector("i");
                if (passed) {
                    el.classList.remove("text-muted", "text-danger");
                    el.classList.add("text-success", "fw-semibold");
                    icon.className = "bi bi-check-circle-fill text-success";
                } else {
                    el.classList.remove("text-success", "fw-semibold");
                    el.classList.add("text-muted");
                    icon.className = "bi bi-circle text-muted";
                }
            }

            function validateAccount() {
                const val = accPass.value || "";
                const s = checkStrength(val);
                updateUI("accReqLen", s.len);
                updateUI("accReqUpper", s.upper);
                updateUI("accReqLower", s.lower);
                updateUI("accReqNum", s.num);
                updateUI("accReqSpec", s.spec);

                if (accConf.value) {
                    if (accConf.value === val) {
                        accMatch.className = "small mt-1 text-success fw-semibold";
                        accMatch.innerHTML = "<i class='bi bi-check-circle-fill me-1'></i> Passwords match";
                        accMatch.classList.remove("d-none");
                    } else {
                        accMatch.className = "small mt-1 text-danger fw-semibold";
                        accMatch.innerHTML = "<i class='bi bi-x-circle-fill me-1'></i> Passwords do not match";
                        accMatch.classList.remove("d-none");
                    }
                } else {
                    accMatch.classList.add("d-none");
                }
                validateVault();
            }

            function validateVault() {
                const val = vltPass.value || "";
                const s = checkStrength(val);
                updateUI("vltReqLen", s.len);
                updateUI("vltReqUpper", s.upper);
                updateUI("vltReqLower", s.lower);
                updateUI("vltReqNum", s.num);
                updateUI("vltReqSpec", s.spec);

                const isDiff = val.length > 0 && val !== accPass.value;
                updateUI("vltReqDiff", isDiff);

                if (vltConf.value) {
                    if (vltConf.value === val) {
                        vltMatch.className = "small mt-1 text-success fw-semibold";
                        vltMatch.innerHTML = "<i class='bi bi-check-circle-fill me-1'></i> Vault passwords match";
                        vltMatch.classList.remove("d-none");
                    } else {
                        vltMatch.className = "small mt-1 text-danger fw-semibold";
                        vltMatch.innerHTML = "<i class='bi bi-x-circle-fill me-1'></i> Vault passwords do not match";
                        vltMatch.classList.remove("d-none");
                    }
                } else {
                    vltMatch.classList.add("d-none");
                }
            }

            accPass.addEventListener("input", validateAccount);
            accConf.addEventListener("input", validateAccount);
            vltPass.addEventListener("input", validateVault);
            vltConf.addEventListener("input", validateVault);
        });
    </script>
}
