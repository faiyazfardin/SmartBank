@model List<SmartBank.DTOs.Loans.LoanDetailsDto>
@{
    ViewData["Title"] = "My Loan Payments & Dues";
}

<div class="container py-4" style="max-width: 950px;">
    <!-- Top Back Link -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
        <a asp-controller="Loan" asp-action="MyApplications" class="btn btn-sm btn-outline-info rounded-pill px-3">
            <i class="bi bi-clock-history me-1"></i> All Applications
        </a>
    </div>

    <!-- Page Header -->
    <div class="sb-card p-4 p-md-5 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="stat-icon-wrapper stat-icon-success" style="width: 52px; height: 52px; font-size: 1.4rem;">
                <i class="bi bi-credit-card-2-front"></i>
            </div>
            <div>
                <h3 class="fw-extrabold text-white mb-1">Loan Payments &amp; Installment Dues</h3>
                <p class="text-secondary small mb-0">Overview of your scheduled loan repayments and completed transactions.</p>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="sb-card p-5 text-center">
            <div class="stat-icon-wrapper stat-icon-primary mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.6rem;">
                <i class="bi bi-check2-circle"></i>
            </div>
            <h5 class="fw-bold text-white mb-2">No Active Loans Found</h5>
            <p class="text-secondary small mb-3">You currently have no active loans or pending installment schedules.</p>
            <a asp-controller="Loan" asp-action="Eligibility" class="btn btn-sm btn-cta-primary px-4 py-2">
                Check Loan Eligibility
            </a>
        </div>
    }
    else
    {
        foreach (var loan in Model)
        {
            var app = loan.Application;
            var upcomingInstallment = loan.Installments.FirstOrDefault(i => i.Status == "Pending" || i.Status == "Overdue" || i.Status == "PartiallyPaid");

            <div class="sb-card p-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom border-secondary border-opacity-25 gap-2">
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 font-monospace">@app.ApplicationNumber</span>
                        <span class="text-white fw-bold ms-2">@app.LoanType Loan</span>
                    </div>
                    <div>
                        <a asp-controller="Loan" asp-action="Details" asp-route-applicationNumber="@app.ApplicationNumber" class="btn btn-sm btn-outline-light rounded-pill px-3">
                            <i class="bi bi-file-earmark-text me-1"></i> Full Schedule
                        </a>
                    </div>
                </div>

                <div class="row g-3 py-3">
                    <div class="col-md-3 col-6">
                        <div class="text-secondary small">Approved Capital</div>
                        <div class="fs-5 fw-bold text-success">৳@(app.ApprovedAmount?.ToString("N2") ?? "0.00")</div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-secondary small">Monthly EMI</div>
                        <div class="fs-5 fw-bold text-warning">৳@(app.FinalEmi?.ToString("N2") ?? "0.00")</div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-secondary small">Total Paid</div>
                        <div class="fs-5 fw-bold text-info">৳@loan.TotalPaid.ToString("N2")</div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-secondary small">Remaining Due</div>
                        <div class="fs-5 fw-bold text-white">৳@loan.TotalRemaining.ToString("N2")</div>
                    </div>
                </div>

                @if (upcomingInstallment != null)
                {
                    <div class="p-3 rounded-3 mt-2 d-flex justify-content-between align-items-center" style="background: rgba(14, 165, 233, 0.1); border: 1px solid rgba(14, 165, 233, 0.3);">
                        <div>
                            <div class="small fw-bold text-info"><i class="bi bi-calendar-event me-1"></i> Next Installment #@upcomingInstallment.InstallmentNumber</div>
                            <div class="small text-secondary">Due: <strong class="text-white">@upcomingInstallment.DueDate.ToString("MMM dd, yyyy")</strong></div>
                        </div>
                        <div class="text-end">
                            <div class="small text-secondary">Amount Due</div>
                            <div class="fs-5 fw-bold text-white">৳@upcomingInstallment.RemainingDue.ToString("N2")</div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
