@model List<SmartBank.DTOs.Loans.LoanApplicationDto>
@{
    ViewData["Title"] = "My Loan Applications";
}

<div class="container py-4" style="max-width: 1050px;">
    <!-- Header Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h3 class="fw-extrabold text-white mb-1">
                <i class="bi bi-wallet-fill text-warning me-2"></i> My Loan Applications
            </h3>
            <p class="text-secondary small mb-0">
                Track your submitted loan requests, review status, and view administrator decisions.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Loan" asp-action="Eligibility" class="btn btn-outline-light rounded-pill px-3">
                <i class="bi bi-speedometer2 me-1"></i> Check Eligibility
            </a>
            <a asp-controller="Loan" asp-action="Apply" class="btn-cta-primary px-3 py-2">
                <i class="bi bi-plus-circle-fill me-1"></i> New Application
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="sb-card p-5 text-center my-4">
            <div class="stat-icon-wrapper stat-icon-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
                <i class="bi bi-inbox"></i>
            </div>
            <h5 class="fw-bold text-white mb-2">No Loan Applications Found</h5>
            <p class="text-secondary small mx-auto mb-4" style="max-width: 450px;">
                You haven't submitted any loan applications yet. Check your eligibility to explore instant credit financing.
            </p>
            <a asp-controller="Loan" asp-action="Eligibility" class="btn-cta-primary px-4 py-2">
                <i class="bi bi-cash-coin me-1"></i> Check Loan Eligibility
            </a>
        </div>
    }
    else
    {
        <!-- Loan Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="stat-widget h-100">
                    <div class="stat-icon-wrapper stat-icon-cyan">
                        <i class="bi bi-files"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">TOTAL APPLIED</div>
                        <div class="fs-4 fw-bold text-white mt-1">@Model.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-widget h-100">
                    <div class="stat-icon-wrapper stat-icon-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">PENDING REVIEW</div>
                        <div class="fs-4 fw-bold text-warning mt-1">@Model.Count(a => a.Status == "Pending")</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-widget h-100">
                    <div class="stat-icon-wrapper stat-icon-success">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">APPROVED LOANS</div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.Count(a => a.Status == "Approved")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Applications Table Card -->
        <div class="sb-card p-0 overflow-hidden">
            <div class="p-3 bg-light border-bottom">
                <h6 class="fw-bold text-white mb-0">
                    <i class="bi bi-list-check text-primary me-2"></i> Application History
                </h6>
            </div>

            <div class="table-responsive">
                <table class="table sb-table mb-0">
                    <thead>
                        <tr>
                            <th>Application #</th>
                            <th>Type</th>
                            <th>Requested</th>
                            <th>Score</th>
                            <th>Status</th>
                            <th>Submitted On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-dark border font-monospace text-info">@app.ApplicationNumber</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-white">@app.LoanType</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">৳@app.RequestedAmount.ToString("N2")</span>
                                </td>
                                <td>
                                    <span class="badge @(app.EligibilityScore >= 80 ? "bg-success-subtle text-success" : app.EligibilityScore >= 65 ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning") rounded-pill">
                                        @app.EligibilityScore pts
                                    </span>
                                </td>
                                <td>
                                    @if (app.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approved
                                        </span>
                                    }
                                    else if (app.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i> Pending Review
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @app.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Loan" asp-action="Details" asp-route-applicationNumber="@app.ApplicationNumber" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
