@model SmartBank.DTOs.Loans.ApplyLoanRequest
@{
    ViewData["Title"] = "Apply for Loan";
    var eligibility = ViewBag.Eligibility as SmartBank.DTOs.Loans.LoanEligibilityResultDto;
    var account = ViewBag.Account as SmartBank.Entities.Account;
    var user = ViewBag.User as SmartBank.Entities.User;
    var maxAmount = eligibility?.MaximumAmount ?? 0m;
}

<div class="container py-4" style="max-width: 800px;">
    <!-- Top Breadcrumb -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="Loan" asp-action="Eligibility" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Eligibility
        </a>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
            <i class="bi bi-check-circle-fill me-1"></i> Pre-Approved Limit: ৳@maxAmount.ToString("N2")
        </span>
    </div>

    <!-- Application Form Card -->
    <div class="sb-card p-4 p-md-5">
        <div class="text-center mb-4 pb-2 border-bottom">
            <div class="stat-icon-wrapper stat-icon-primary mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                <i class="bi bi-cash-coin"></i>
            </div>
            <h3 class="fw-extrabold text-white mb-1">Smart Loan Application</h3>
            <p class="text-secondary small mb-0">
                Submit your loan request. Applications are processed seamlessly by our credit review team.
            </p>
        </div>

        <!-- Pre-Approved Summary Banner -->
        <div class="p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center" style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25);">
            <div>
                <div class="text-muted small fw-semibold">BENEFICIARY ACCOUNT</div>
                <div class="fw-bold text-white fs-6">
                    @(user?.FullName) • <code class="text-info">@(account?.AccountNumber)</code>
                </div>
            </div>
            <div class="text-end">
                <div class="text-muted small fw-semibold">MAXIMUM ELIGIBLE SUM</div>
                <div class="fw-bold text-success fs-5">৳@maxAmount.ToString("N2")</div>
            </div>
        </div>

        <form asp-controller="Loan" asp-action="Apply" method="post" id="loanApplyForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm small mb-4" role="alert"></div>

            <!-- Loan Type Selection -->
            <div class="mb-4">
                <label asp-for="LoanType" class="form-label fw-bold text-white small">LOAN CATEGORY <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-tag-fill"></i></span>
                    <select asp-for="LoanType" class="form-select form-select-lg bg-dark text-white border-secondary">
                        <option value="Personal">Personal Loan</option>
                        <option value="Business">Small Business Loan</option>
                        <option value="Education">Higher Education Financing</option>
                        <option value="Emergency">Emergency Liquidity</option>
                        <option value="Home">Home Renovation Loan</option>
                    </select>
                </div>
                <span asp-validation-for="LoanType" class="text-danger small"></span>
            </div>

            <!-- Monthly Income (Income Verification) -->
            <div class="mb-4">
                <label asp-for="MonthlyIncome" class="form-label fw-bold text-white small">DECLARED MONTHLY INCOME (৳) <span class="text-muted fw-normal">(Optional)</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary">৳</span>
                    <input asp-for="MonthlyIncome" type="number" step="500" min="0" max="10000000" class="form-control form-control-lg bg-dark text-white border-secondary" placeholder="e.g. 75,000" />
                </div>
                <div class="form-text text-secondary" style="font-size: 0.78rem;">Your primary monthly salary or business turnover.</div>
                <span asp-validation-for="MonthlyIncome" class="text-danger small"></span>
            </div>

            <!-- Requested Loan Amount -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="RequestedAmount" class="form-label fw-bold text-white small mb-0">REQUESTED LOAN AMOUNT (৳) <span class="text-danger">*</span></label>
                    <span class="text-info small">Max: ৳@maxAmount.ToString("N2")</span>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary">৳</span>
                    <input asp-for="RequestedAmount" id="inputLoanAmount" type="number" step="1000" min="1000" max="@maxAmount" class="form-control form-control-lg bg-dark text-white border-secondary fs-4 fw-bold" placeholder="0.00" required />
                </div>
                
                <!-- Fast Selection Amount Chips -->
                <div class="d-flex flex-wrap gap-2 mt-2" id="loanChipsContainer">
                    @if (maxAmount >= 25000)
                    {
                        <button type="button" class="preset-chip" data-value="25000">৳25,000</button>
                    }
                    @if (maxAmount >= 50000)
                    {
                        <button type="button" class="preset-chip" data-value="50000">৳50,000</button>
                    }
                    @if (maxAmount >= 100000)
                    {
                        <button type="button" class="preset-chip" data-value="100000">৳100,000</button>
                    }
                    @if (maxAmount >= 200000)
                    {
                        <button type="button" class="preset-chip" data-value="200000">৳200,000</button>
                    }
                    <button type="button" class="preset-chip active" data-value="@maxAmount">Max (৳@maxAmount.ToString("N0"))</button>
                </div>
                <span asp-validation-for="RequestedAmount" class="text-danger small" id="errLoanAmount"></span>
            </div>

            <!-- Loan Purpose -->
            <div class="mb-4">
                <label asp-for="Purpose" class="form-label fw-bold text-white small">LOAN PURPOSE & STATEMENT <span class="text-danger">*</span></label>
                <textarea asp-for="Purpose" rows="3" class="form-control bg-dark text-white border-secondary" placeholder="Please describe how this loan will be utilized (e.g., Medical treatment, inventory purchase, tuition fees)..." required></textarea>
                <div class="form-text text-secondary" style="font-size: 0.78rem;">Minimum 5 characters. Must be clear for administrative review.</div>
                <span asp-validation-for="Purpose" class="text-danger small"></span>
            </div>

            <!-- Simulation Scope & Terms Disclaimer -->
            <div class="p-3 rounded-3 mb-4 bg-light border border-white-10">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="termsCheck" required checked>
                    <label class="form-check-label text-secondary small" for="termsCheck">
                        I certify that the information provided is true and accurate. I understand that loan approval is subject to automated rule validation and administrator approval.
                    </label>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn-cta-primary py-3 fs-6" id="btnSubmitLoan">
                    <i class="bi bi-send-check-fill me-2"></i> Submit Loan Application
                </button>
                <a asp-controller="Loan" asp-action="Eligibility" class="btn btn-outline-secondary rounded-pill py-2">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const amountInput = document.getElementById('inputLoanAmount');
            const chips = document.querySelectorAll('#loanChipsContainer .preset-chip');
            const maxVal = @maxAmount;

            chips.forEach(chip => {
                chip.addEventListener('click', (e) => {
                    e.preventDefault();
                    const val = chip.getAttribute('data-value');
                    amountInput.value = val;
                    chips.forEach(c => c.classList.remove('active'));
                    chip.classList.add('active');
                });
            });

            amountInput.addEventListener('input', () => {
                const val = parseFloat(amountInput.value) || 0;
                const errSpan = document.getElementById('errLoanAmount');
                if (val > maxVal) {
                    errSpan.innerText = `Requested amount exceeds your maximum eligible limit of ৳${maxVal.toLocaleString()}.`;
                } else if (val < 1000) {
                    errSpan.innerText = "Minimum loan amount is ৳1,000.";
                } else {
                    errSpan.innerText = "";
                }
            });
        });
    </script>
}
