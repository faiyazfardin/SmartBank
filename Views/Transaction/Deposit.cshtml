@model SmartBank.Entities.Account
@{
    ViewData["Title"] = "Deposit Money";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="sb-card p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="stat-icon-wrapper stat-icon-success">
                        <i class="bi bi-arrow-down-circle-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-dark mb-0">Deposit Funds</h3>
                        <div class="text-muted small">Instant real-time credit to your checking account</div>
                    </div>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4">
                        <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                        <div>@ViewBag.ErrorMessage</div>
                    </div>
                }

                <div class="p-3 bg-light rounded-3 border mb-4 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">Account Number</div>
                        <div class="fw-bold font-monospace text-dark">@(Model?.AccountNumber ?? "N/A")</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Current Balance</div>
                        <div class="fw-bold text-success fs-5">৳@(Model?.Balance.ToString("N2") ?? "0.00")</div>
                    </div>
                </div>

                <form asp-controller="Transaction" asp-action="Deposit" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Preset Amount Buttons -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small mb-2">Select Quick Preset Amount</label>
                        <div class="preset-chip-group">
                            <div class="preset-chip" data-value="500">৳500</div>
                            <div class="preset-chip" data-value="1000">৳1,000</div>
                            <div class="preset-chip" data-value="2500">৳2,500</div>
                            <div class="preset-chip" data-value="5000">৳5,000</div>
                            <div class="preset-chip" data-value="10000">৳10,000</div>
                            <div class="preset-chip" data-value="25000">৳25,000</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small">Custom Deposit Amount (৳) *</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-bold text-dark">৳</span>
                            <input type="number" id="inputCustomAmount" name="amount" class="form-control fw-bold fs-4" placeholder="0.00" min="1" step="0.01" required />
                        </div>
                        <div class="form-text small text-muted">Minimum deposit is ৳1.00. Funds will be available immediately.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary w-50 py-2 fw-semibold rounded-pill">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-sb-success w-50 py-2 fw-bold rounded-pill shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Confirm Deposit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>