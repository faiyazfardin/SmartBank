@{
    ViewData["Title"] = "Transfer Funds";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Transfer Funds</h4>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form asp-controller="Transaction" asp-action="Transfer" method="post">
                    <div class="form-floating mb-3">
                        <input type="text" name="recipientAccountNumber" class="form-control" placeholder="Account number" required />
                        <label>Recipient Account Number</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="number" step="0.01" min="1" name="amount" class="form-control" placeholder="0.00" required />
                        <label>Amount to Transfer (৳)</label>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
                        <button type="submit" class="btn btn-warning">Send Transfer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>