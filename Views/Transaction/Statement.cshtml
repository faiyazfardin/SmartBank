@model List<SmartBank.Entities.Transaction>
@{
    ViewData["Title"] = "Official Bank Account Statement";
    var user = ViewBag.User as SmartBank.Entities.User;
    var account = ViewBag.Account as SmartBank.Entities.Account;
    DateTime fromDate = ViewBag.FromDate;
    DateTime toDate = ViewBag.ToDate;
    decimal totalCredits = ViewBag.TotalCredits ?? 0m;
    decimal totalDebits = ViewBag.TotalDebits ?? 0m;
}

<style>
    @@media print {
        body {
            background: #ffffff !important;
            color: #000000 !important;
        }
        .no-print, header, footer, nav, .btn {
            display: none !important;
        }
        .statement-paper {
            background: #ffffff !important;
            color: #000000 !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }
        .statement-paper * {
            color: #000000 !important;
            background: transparent !important;
            border-color: #cbd5e1 !important;
            box-shadow: none !important;
        }
        .statement-paper .text-white, 
        .statement-paper .text-muted, 
        .statement-paper .text-secondary {
            color: #1e293b !important;
        }
        .statement-paper .text-success {
            color: #15803d !important;
        }
        .statement-paper .text-danger {
            color: #b91c1c !important;
        }
        .statement-paper .text-info, 
        .statement-paper .text-primary {
            color: #0284c7 !important;
        }
        .statement-paper .badge {
            border: 1px solid #94a3b8 !important;
            background: #f1f5f9 !important;
            color: #0f172a !important;
        }
        .statement-paper .summary-box {
            background: #f8fafc !important;
            border: 1px solid #e2e8f0 !important;
        }
        .statement-paper table {
            border: 1px solid #cbd5e1 !important;
            width: 100% !important;
        }
        .statement-paper th, 
        .statement-paper td {
            border: 1px solid #cbd5e1 !important;
            padding: 8px 10px !important;
            background: #ffffff !important;
            color: #0f172a !important;
        }
        .statement-paper thead th {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
            font-weight: 700 !important;
        }
        .statement-paper tfoot tr, 
        .statement-paper tfoot td {
            background-color: #f8fafc !important;
            color: #0f172a !important;
            font-weight: 700 !important;
        }
    }
</style>

<div class="container py-4">
    <!-- Action controls (hidden when printing) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
            <h4 class="fw-bold mb-0 text-white">Official Account Statement</h4>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i> Print / Save as PDF
            </button>
        </div>
    </div>

    <!-- Date Range Filter Card (hidden when printing) -->
    <div class="sb-card p-3 mb-4 no-print">
        <form asp-controller="Transaction" asp-action="Statement" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted fw-semibold">From Date</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@fromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted fw-semibold">To Date</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@toDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-sm btn-outline-primary w-100 fw-semibold rounded-pill">
                    <i class="bi bi-funnel me-1"></i> Filter Statement
                </button>
            </div>
        </form>
    </div>

    <!-- Printable Statement Paper Container -->
    <div class="sb-card p-4 p-md-5 statement-paper">
        <!-- Bank Formal Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom border-secondary-subtle pb-4 mb-4">
            <div>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="brand-icon-box fs-4">
                        <i class="bi bi-bank"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-white mb-0">SmartBank <span class="text-primary fs-5 fw-semibold">PLC</span></h2>
                        <div class="small text-muted">Core Ledger System &amp; Digital Banking</div>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-geo-alt me-1"></i>Head Office: 14/A Financial District, Gulshan Avenue, Dhaka-1212<br />
                    <i class="bi bi-shield-check me-1"></i>SWIFT: SBNKBDDH | Web: www.smartbank.com | Email: support@smartbank.com
                </div>
            </div>
            <div class="text-end">
                <span class="badge bg-primary bg-gradient px-3 py-2 fs-6 mb-2 rounded-pill shadow-sm"><i class="bi bi-file-earmark-text me-1"></i> ACCOUNT STATEMENT</span>
                <div class="small text-muted">Generated: <strong class="text-white">@DateTime.UtcNow.ToString("MMM dd, yyyy HH:mm") UTC</strong></div>
            </div>
        </div>

        <!-- Account Holder & Summary Grid -->
        <div class="row g-4 mb-4 pb-4 border-bottom border-secondary-subtle">
            <div class="col-md-6">
                <div class="summary-box p-3 rounded-3" style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <h6 class="fw-bold text-uppercase small text-primary mb-3">
                        <i class="bi bi-person-badge me-1"></i> Account Holder Details
                    </h6>
                    <div class="fs-5 fw-bold text-white mb-1">@user?.FullName</div>
                    <div class="text-muted small mb-1"><i class="bi bi-at text-secondary me-1"></i>Username: <span class="text-white fw-semibold">@@@user?.Username</span></div>
                    <div class="text-muted small mb-1"><i class="bi bi-envelope text-secondary me-1"></i>Email: <span class="text-white fw-semibold">@user?.Email</span></div>
                    <div class="text-muted small"><i class="bi bi-telephone text-secondary me-1"></i>Phone: <span class="text-white fw-semibold">@(user?.PhoneNumber ?? "Not provided")</span></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="summary-box p-3 rounded-3" style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <h6 class="fw-bold text-uppercase small text-primary mb-3">
                        <i class="bi bi-card-checklist me-1"></i> Statement Summary
                    </h6>
                    <div class="d-flex justify-content-between text-muted small py-1 border-bottom border-secondary-subtle">
                        <span>Account Number:</span>
                        <strong class="font-monospace text-white">@(account?.AccountNumber ?? "N/A")</strong>
                    </div>
                    <div class="d-flex justify-content-between text-muted small py-1 border-bottom border-secondary-subtle">
                        <span>Statement Period:</span>
                        <strong class="text-white">@fromDate.ToString("MMM dd, yyyy") — @toDate.ToString("MMM dd, yyyy")</strong>
                    </div>
                    <div class="d-flex justify-content-between text-muted small py-1 border-bottom border-secondary-subtle">
                        <span>Total Inflow (Credits):</span>
                        <strong class="text-success fw-bold">+৳@totalCredits.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between text-muted small py-1 border-bottom border-secondary-subtle">
                        <span>Total Outflow (Debits):</span>
                        <strong class="text-danger fw-bold">-৳@totalDebits.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between text-muted small pt-2">
                        <span class="fw-bold text-white">Current Balance:</span>
                        <strong class="text-info fs-6 fw-bold">৳@(account?.Balance.ToString("N2") ?? "0.00")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statement Transactions Table -->
        <h6 class="fw-bold text-uppercase small text-primary mb-3">
            <i class="bi bi-list-columns-reverse me-1"></i> Itemized Transaction Record
        </h6>
        <div class="table-responsive rounded-3 overflow-hidden border border-secondary-subtle mb-4">
            <table class="table sb-table align-middle small mb-0">
                <thead>
                    <tr>
                        <th style="width: 18%;">Date &amp; Time</th>
                        <th style="width: 20%;">Ref / Transaction ID</th>
                        <th style="width: 26%;">Transaction Description</th>
                        <th class="text-end" style="width: 18%;">Credit (Deposit/In)</th>
                        <th class="text-end" style="width: 18%;">Debit (Withdraw/Out)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var tx in Model)
                        {
                            var isCredit = tx.Type == SmartBank.Entities.TransactionType.Deposit || tx.Type == SmartBank.Entities.TransactionType.TransferIn;
                            <tr>
                                <td class="text-nowrap text-white-50"><i class="bi bi-clock me-1 text-muted"></i>@tx.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="badge font-monospace px-2 py-1" style="background: rgba(255, 255, 255, 0.08); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.35);">#TX-@tx.Id.ToString("D6")</span>
                                </td>
                                <td>
                                    @if (tx.Type == SmartBank.Entities.TransactionType.Deposit)
                                    {
                                        <span class="badge-active me-1">
                                            <i class="bi bi-arrow-down-left"></i> Deposit
                                        </span>
                                    }
                                    else if (tx.Type == SmartBank.Entities.TransactionType.Withdraw)
                                    {
                                        <span class="badge-frozen me-1">
                                            <i class="bi bi-arrow-up-right"></i> Withdraw
                                        </span>
                                    }
                                    else if (tx.Type == SmartBank.Entities.TransactionType.TransferIn)
                                    {
                                        <span class="badge bg-info-subtle text-info fw-bold py-1 px-2 rounded-pill me-1">
                                            <i class="bi bi-arrow-down-left"></i> Transfer In
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-suspended me-1">
                                            <i class="bi bi-arrow-up-right"></i> Transfer Out
                                        </span>
                                    }

                                    @if (tx.RelatedAccountId.HasValue)
                                    {
                                        <span class="text-muted small ms-1">(Ref Acc: #@tx.RelatedAccountId.Value)</span>
                                    }
                                </td>
                                <td class="text-end font-monospace @(isCredit ? "text-success fw-bold fs-6" : "text-muted")">
                                    @(isCredit ? $"+৳{tx.Amount:N2}" : "—")
                                </td>
                                <td class="text-end font-monospace @(!isCredit ? "text-danger fw-bold fs-6" : "text-muted")">
                                    @(!isCredit ? $"-৳{tx.Amount:N2}" : "—")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                                No transactions recorded for the selected date range.
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="fw-bold" style="border-top: 2px solid rgba(255, 255, 255, 0.12);">
                    <tr>
                        <td colspan="3" class="text-end text-uppercase small py-3" style="background: rgba(15, 23, 42, 0.95) !important; color: #94a3b8 !important;">PERIOD TOTALS:</td>
                        <td class="text-end font-monospace fs-6 py-3" style="background: rgba(15, 23, 42, 0.95) !important; color: #34d399 !important;">+৳@totalCredits.ToString("N2")</td>
                        <td class="text-end font-monospace fs-6 py-3" style="background: rgba(15, 23, 42, 0.95) !important; color: #f87171 !important;">-৳@totalDebits.ToString("N2")</td>
                    </tr>
                </tfoot>

            </table>
        </div>

        <!-- Official Bank Seal & Sign Off -->
        <div class="d-flex justify-content-between align-items-end pt-4 mt-4 border-top border-secondary-subtle">
            <div class="small text-muted" style="max-width: 420px;">
                <em>This statement is an electronically generated legal document from SmartBank Digital Banking Core. It is valid without manual stamp or signature under the Digital Banking Act.</em>
            </div>
            <div class="text-center">
                <div class="border-bottom border-secondary pb-1 mb-1" style="width: 180px;">
                    <span class="font-monospace fw-bold small text-primary">SmartBank Core Ledger</span>
                </div>
                <div class="small text-muted">Authorized Bank Officer</div>
            </div>
        </div>
    </div>
</div>
