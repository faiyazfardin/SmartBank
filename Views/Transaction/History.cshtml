@model List<SmartBank.Entities.Transaction>

@{
    ViewData["Title"] = "Transaction History";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Transaction History</h2>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary">No transactions recorded yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover mt-3 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Date & Time</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Reference Account</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    var isPositive = t.Type == SmartBank.Entities.TransactionType.Deposit || t.Type == SmartBank.Entities.TransactionType.TransferIn;
                    <tr>
                        <td>@t.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <span class="badge @(isPositive ? "bg-success" : "bg-danger")">
                                @t.Type
                            </span>
                        </td>
                        <td class="fw-bold @(isPositive ? "text-success" : "text-danger")">
                            @(isPositive ? "+" : "-")@t.Amount.ToString("C")
                        </td>
                        <td>
                            @(t.RelatedAccountId.HasValue ? $"Account #{t.RelatedAccountId.Value}" : "-")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}