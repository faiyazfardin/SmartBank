@model List<SmartBank.Models.Transaction>

@{
    ViewData["Title"] = "Transaction History";
}

<h2>Transaction History</h2>

@if (!Model.Any())
{
    <p>No transactions yet.</p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Timestamp.ToString("g")</td>
                    <td>@t.Type</td>
                    <td class="@(t.Type == SmartBank.Models.TransactionType.Deposit || t.Type == SmartBank.Models.TransactionType.TransferIn ? "text-success" : "text-danger")">
                        @(t.Type == SmartBank.Models.TransactionType.Deposit || t.Type == SmartBank.Models.TransactionType.TransferIn ? "+" : "-")@t.Amount.ToString("C")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}