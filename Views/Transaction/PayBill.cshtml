@model SmartBank.Entities.Account
@{
    ViewData["Title"] = "Pay Utility Bills";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="sb-card p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="stat-icon-wrapper stat-icon-info">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-dark mb-0">Utility & Bill Payment</h3>
                        <div class="text-muted small">Pay electricity, water, gas, internet & mobile bills instantly</div>
                    </div>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4">
                        <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                        <div>@ViewBag.ErrorMessage</div>
                    </div>
                }

                <div class="p-3 bg-light rounded-3 border mb-4 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">Paying From</div>
                        <div class="fw-bold font-monospace text-dark">@(Model?.AccountNumber ?? "N/A")</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Available Balance</div>
                        <div class="fw-bold text-primary fs-5">৳@(Model?.Balance.ToString("N2") ?? "0.00")</div>
                    </div>
                </div>

                <form asp-controller="Transaction" asp-action="PayBill" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Select Biller Category *</label>
                        <select id="selectCategory" name="billerCategory" class="form-select" required>
                            <option value="Electricity">⚡ Electricity (DESCO / DPDC / NESCO)</option>
                            <option value="Water">💧 Water & Sewerage (DWASA / CWASA)</option>
                            <option value="Gas">🔥 Gas (Titas Gas / Bakhrabad)</option>
                            <option value="Internet">🌐 Broadband Internet (FiberNet / Link3 / Dot)</option>
                            <option value="Mobile">📱 Mobile Recharge (Grameenphone / Robi / Banglalink)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Service Provider / Biller *</label>
                        <input type="text" id="inputBillerName" name="billerName" class="form-control" value="DESCO Electricity Postpaid" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Customer Account Number / Meter # *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-hash"></i></span>
                            <input type="text" name="billNumber" class="form-control font-monospace" placeholder="e.g. 1029384756" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small">Bill Amount (৳) *</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-bold text-dark">৳</span>
                            <input type="number" name="amount" class="form-control fw-bold fs-4" placeholder="0.00" min="1" max="@(Model?.Balance ?? 0)" step="0.01" required />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary w-50 py-2 fw-semibold rounded-pill">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-info text-white w-50 py-2 fw-bold rounded-pill shadow-sm">
                            <i class="bi bi-check2-all me-1"></i> Pay Bill Now
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const selectCat = document.getElementById('selectCategory');
    const billerName = document.getElementById('inputBillerName');

    if (selectCat && billerName) {
        selectCat.addEventListener('change', () => {
            const cat = selectCat.value;
            if (cat === 'Electricity') billerName.value = 'DESCO Electricity Postpaid';
            else if (cat === 'Water') billerName.value = 'Dhaka WASA Water Supply';
            else if (cat === 'Gas') billerName.value = 'Titas Gas Transmission';
            else if (cat === 'Internet') billerName.value = 'FiberNet Highspeed Broadband';
            else if (cat === 'Mobile') billerName.value = 'Grameenphone Prepaid FlexiLoad';
        });
    }
</script>
}
