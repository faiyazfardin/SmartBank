@using System.Security.Claims

<div class="d-flex align-items-center gap-2">
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User";
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    if (string.IsNullOrEmpty(initials)) { initials = "SB"; }
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "Customer";

    <div class="dropdown">
        <button class="btn btn-dark dropdown-toggle d-flex align-items-center gap-2 border-secondary py-1-5 px-3 rounded-pill" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold small" style="width: 32px; height: 32px; font-size: 0.8rem;">
                @initials
            </span>
            <span class="text-white text-truncate fw-semibold small" style="max-width: 140px;">
                @fullName
            </span>
            @if (role == "Admin")
            {
                <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">ADMIN</span>
            }
        </button>
        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg border-0 py-2" aria-labelledby="userMenuDropdown">
            <li class="px-3 py-2 border-bottom border-secondary mb-1">
                <div class="small text-white-50">Signed in as</div>
                <div class="fw-bold text-white small">@User.Identity.Name</div>
                <div class="badge @(role == "Admin" ? "bg-danger" : "bg-secondary") mt-1">@role Account</div>
            </li>
            @if (role == "Admin")
            {
                <li>
                    <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-shield-check me-2 text-warning"></i> Admin Command Center
                    </a>
                </li>
            }
            else
            {
                <li>
                    <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-person-circle me-2 text-primary"></i> Account Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" asp-controller="Transaction" asp-action="Statement">
                        <i class="bi bi-file-earmark-text me-2 text-info"></i> Account Statement
                    </a>
                </li>
            }
            <li><hr class="dropdown-divider bg-secondary"></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger rounded py-2 d-flex align-items-center">
                        <i class="bi bi-box-arrow-right me-2"></i> Log Out
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-login-nav px-3 py-2 fw-semibold rounded-pill d-inline-flex align-items-center gap-1" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Log In</span>
        </a>
        <a class="btn btn-register-nav px-3 py-2 fw-bold rounded-pill d-inline-flex align-items-center gap-1" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus-fill"></i>
            <span>Register</span>
        </a>
    </div>
}
</div>

