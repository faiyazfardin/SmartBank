@using System.Security.Claims

<ul class="navbar-nav">
@if (User.Identity != null && User.Identity.IsAuthenticated)
{   
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link text-danger fw-bold" asp-area="" asp-controller="Admin" asp-action="Users">Admin Panel</a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    </li>
    <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Transaction" asp-action="Deposit">Deposit</a></li>
    <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Transaction" asp-action="Withdraw">Withdraw</a></li>
    <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Transaction" asp-action="Transfer">Transfer</a></li>
    <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Transaction" asp-action="History">History</a></li>
    <li class="nav-item">
        <span class="nav-link text-dark">Hello, @(User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User")!</span>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" href="/swagger">Swagger API Docs</a>
    </li>
}
</ul>
