@model SmartBank.ViewModels.VerifySecurityQuestionViewModel
@{
    ViewData["Title"] = "Vault Recovery — Step 1: Security Question";
}

<div class="auth-wrapper py-5">
    <div class="auth-card-pro" style="max-width: 520px;">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-icon-box mx-auto mb-3 shadow-glow" style="width: 58px; height: 58px; font-size: 1.6rem; background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3);">
                <i class="bi bi-shield-question text-info"></i>
            </div>
            <h3 class="fw-bold text-white mb-1 tracking-tight">Forgot Vault Password</h3>
            <p class="text-secondary small mb-0">Step 1 of 3: Verify your security answer to request a Vault reset code.</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger alert-dismissible fade show d-flex align-items-center mb-4 rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div class="small fw-semibold">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-controller="Vault" asp-action="VerifySecurityQuestion" method="post" id="securityQuestionForm">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="form-label fw-semibold small text-light opacity-90 mb-2">Security Question</label>
                <div class="p-3 rounded-3 mb-3 border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.6);">
                    <div class="d-flex align-items-center gap-2 text-info fw-semibold">
                        <i class="bi bi-question-circle-fill fs-5"></i>
                        <span>@Model.SecurityQuestion</span>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="SecurityAnswer" class="form-label fw-semibold small text-light opacity-90 mb-1">Your Secret Answer</label>
                <div class="input-group auth-input-group">
                    <span class="input-group-text"><i class="bi bi-key-fill text-success"></i></span>
                    <input asp-for="SecurityAnswer" class="form-control" placeholder="Enter answer (case-insensitive)" required autofocus />
                </div>
                <div class="form-text small text-secondary">
                    <i class="bi bi-shield-exclamation me-1 text-warning"></i> Warning: 3 incorrect answers will freeze your account.
                </div>
                <span asp-validation-for="SecurityAnswer" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-cta-primary w-100 py-2-5 fw-bold shadow-glow mb-3">
                <i class="bi bi-arrow-right-circle-fill me-2"></i> Verify Answer &amp; Request OTP
            </button>

            <div class="text-center">
                <a asp-controller="Vault" asp-action="Index" class="text-secondary small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Back to Vault
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
