@model SmartBank.ViewModels.ResetVaultPasswordViewModel
@{
    ViewData["Title"] = "Vault Recovery — Step 3: Set New Vault Password";
}

<div class="auth-wrapper py-5">
    <div class="auth-card-pro" style="max-width: 520px;">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-icon-box mx-auto mb-3 shadow-glow" style="width: 58px; height: 58px; font-size: 1.6rem; background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3);">
                <i class="bi bi-safe2-fill text-success"></i>
            </div>
            <h3 class="fw-bold text-white mb-1 tracking-tight">Set New Vault Password</h3>
            <p class="text-secondary small mb-0">Step 3 of 3: Enter your new Security Vault Password to restore access.</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger alert-dismissible fade show d-flex align-items-center mb-4 rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div class="small fw-semibold">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-controller="Vault" asp-action="ResetVaultPassword" method="post" id="resetVaultPasswordForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label asp-for="NewVaultPassword" class="form-label fw-semibold small text-light opacity-90 mb-1"></label>
                <div class="input-group auth-input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill text-info"></i></span>
                    <input asp-for="NewVaultPassword" id="inputNewVaultPass" class="form-control" placeholder="Minimum 8 characters" required autofocus />
                </div>
                <span asp-validation-for="NewVaultPassword" class="text-danger small"></span>

                <!-- Live Strength Criteria for Vault Password -->
                <div class="p-2-5 rounded-3 mt-2 small" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.06);">
                    <div class="d-flex align-items-center gap-2 mb-1" id="vltReqLen"><i class="bi bi-circle text-muted"></i> <span>At least 8 characters</span></div>
                    <div class="d-flex align-items-center gap-2 mb-1" id="vltReqUpper"><i class="bi bi-circle text-muted"></i> <span>At least 1 uppercase letter (A-Z)</span></div>
                    <div class="d-flex align-items-center gap-2 mb-1" id="vltReqLower"><i class="bi bi-circle text-muted"></i> <span>At least 1 lowercase letter (a-z)</span></div>
                    <div class="d-flex align-items-center gap-2 mb-1" id="vltReqNum"><i class="bi bi-circle text-muted"></i> <span>At least 1 number (0-9)</span></div>
                    <div class="d-flex align-items-center gap-2" id="vltReqSpec"><i class="bi bi-circle text-muted"></i> <span>At least 1 special character (!@@#$%^&*)</span></div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmVaultPassword" class="form-label fw-semibold small text-light opacity-90 mb-1"></label>
                <div class="input-group auth-input-group">
                    <span class="input-group-text"><i class="bi bi-check2-circle text-success"></i></span>
                    <input asp-for="ConfirmVaultPassword" id="inputConfirmVaultPass" class="form-control" placeholder="Repeat new vault password" required />
                </div>
                <span asp-validation-for="ConfirmVaultPassword" class="text-danger small"></span>
                <div id="vaultMatchMsg" class="small mt-1 d-none"></div>
            </div>

            <button type="submit" id="btnSaveVaultPass" class="btn-cta-primary w-100 py-2-5 fw-bold shadow-glow mb-3">
                <i class="bi bi-check-circle-fill me-2"></i> Save &amp; Unlock Vault
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vltPass = document.getElementById('inputNewVaultPass');
            const vltConf = document.getElementById('inputConfirmVaultPass');
            const vltMatch = document.getElementById('vaultMatchMsg');

            function checkStrength(val) {
                return {
                    len: val.length >= 8,
                    upper: /[A-Z]/.test(val),
                    lower: /[a-z]/.test(val),
                    num: /[0-9]/.test(val),
                    spec: /[^A-Za-z0-9]/.test(val)
                };
            }

            function updateUI(reqId, passed) {
                const el = document.getElementById(reqId);
                if (!el) return;
                const icon = el.querySelector("i");
                if (passed) {
                    el.classList.remove("text-muted");
                    el.classList.add("text-success", "fw-semibold");
                    icon.className = "bi bi-check-circle-fill text-success";
                } else {
                    el.classList.remove("text-success", "fw-semibold");
                    el.classList.add("text-muted");
                    icon.className = "bi bi-circle text-muted";
                }
            }

            function validateVault() {
                const val = vltPass.value || "";
                const s = checkStrength(val);
                updateUI("vltReqLen", s.len);
                updateUI("vltReqUpper", s.upper);
                updateUI("vltReqLower", s.lower);
                updateUI("vltReqNum", s.num);
                updateUI("vltReqSpec", s.spec);

                if (vltConf.value) {
                    if (vltConf.value === val) {
                        vltMatch.textContent = "✓ Passwords match";
                        vltMatch.className = "small mt-1 text-success fw-semibold";
                    } else {
                        vltMatch.textContent = "✕ Passwords do not match";
                        vltMatch.className = "small mt-1 text-danger";
                    }
                } else {
                    vltMatch.className = "small mt-1 d-none";
                }
            }

            if (vltPass) vltPass.addEventListener("input", validateVault);
            if (vltConf) vltConf.addEventListener("input", validateVault);
        });
    </script>
}
