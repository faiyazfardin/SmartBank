@{
    ViewData["Title"] = "Vault Recovery — Step 2: Verification Code";
    string maskedEmail = ViewBag.MaskedEmail as string ?? "j******e@g***l.com";
    int otpCount = ViewBag.OtpCount != null ? (int)ViewBag.OtpCount : 1;
}

<div class="auth-wrapper py-5">
    <div class="auth-card-pro" style="max-width: 520px;">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-icon-box mx-auto mb-3 shadow-glow" style="width: 58px; height: 58px; font-size: 1.6rem; background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3);">
                <i class="bi bi-envelope-check-fill text-info"></i>
            </div>
            <h3 class="fw-bold text-white mb-1 tracking-tight">Vault Recovery Code</h3>
            <p class="text-secondary small mb-1">Step 2 of 3: We have sent a 6-digit verification code to</p>
            <div class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-1-5 rounded-pill fw-mono small mb-2">
                <i class="bi bi-shield-lock me-1"></i> @maskedEmail
            </div>
            <div>
                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2-5 py-1 rounded-pill small" id="otpAttemptBadge">
                    OTP Attempt <span id="currentOtpNum">@otpCount</span> of 3
                </span>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger alert-dismissible fade show d-flex align-items-center mb-4 rounded-3" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                <div class="small fw-semibold">@ViewBag.Error</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div id="ajaxAlertContainer"></div>

        <form asp-controller="Vault" asp-action="VerifyVaultResetOtp" method="post" id="vaultOtpForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="otpCode" id="hiddenOtpCode" />

            <div class="mb-4">
                <label class="form-label fw-semibold small text-light opacity-90 mb-2 text-center w-100">Enter 6-Digit Verification Code</label>
                <div class="d-flex justify-content-center gap-2 mb-3" id="otpBoxContainer">
                    <input type="text" class="form-control text-center fs-4 fw-bold otp-digit-box" maxlength="1" pattern="[0-9]" inputmode="numeric" autofocus />
                    <input type="text" class="form-control text-center fs-4 fw-bold otp-digit-box" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                    <input type="text" class="form-control text-center fs-4 fw-bold otp-digit-box" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                    <input type="text" class="form-control text-center fs-4 fw-bold otp-digit-box" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                    <input type="text" class="form-control text-center fs-4 fw-bold otp-digit-box" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                    <input type="text" class="form-control text-center fs-4 fw-bold otp-digit-box" maxlength="1" pattern="[0-9]" inputmode="numeric" />
                </div>
            </div>

            <!-- Countdown Timer -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1-5 rounded-pill bg-dark border border-secondary border-opacity-25">
                    <i class="bi bi-clock-history text-warning"></i>
                    <span class="small text-secondary">Code Expires In:</span>
                    <span class="fw-bold fw-mono text-warning" id="timerDisplay">05:00</span>
                </div>
            </div>

            <button type="submit" id="btnSubmitVaultOtp" class="btn-cta-primary w-100 py-2-5 fw-bold shadow-glow mb-3">
                <i class="bi bi-check-circle-fill me-2"></i> Verify Code &amp; Continue
            </button>
        </form>

        <form id="resendOtpForm">
            @Html.AntiForgeryToken()
            <div class="text-center pt-2">
                <p class="text-secondary small mb-1">Didn't receive the code?</p>
                <button type="button" id="btnResendOtp" class="btn btn-link text-info text-decoration-none p-0 fw-semibold small" @(otpCount >= 3 ? "disabled" : "")>
                    <i class="bi bi-arrow-clockwise me-1"></i> Request Next OTP
                </button>
            </div>
        </form>

        <div class="text-center mt-3">
            <a asp-controller="Vault" asp-action="Index" class="text-secondary small text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Cancel &amp; Back to Vault
            </a>
        </div>
    </div>
</div>

<style>
    .otp-digit-box {
        width: 48px;
        height: 56px;
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        border-radius: 8px;
        transition: all 0.2s ease;
    }
    .otp-digit-box:focus {
        background: rgba(15, 23, 42, 0.9);
        border-color: #6366f1;
        box-shadow: 0 0 12px rgba(99, 102, 241, 0.4);
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const boxes = Array.from(document.querySelectorAll('.otp-digit-box'));
            const hiddenInput = document.getElementById('hiddenOtpCode');
            const form = document.getElementById('vaultOtpForm');
            const timerDisplay = document.getElementById('timerDisplay');
            const resendBtn = document.getElementById('btnResendOtp');
            const ajaxContainer = document.getElementById('ajaxAlertContainer');
            const currentOtpSpan = document.getElementById('currentOtpNum');

            let timeLeft = 300; // 5 minutes (300s)
            let timerInterval = null;
            let isSubmitting = false;

            function startTimer(seconds) {
                if (timerInterval) clearInterval(timerInterval);
                timeLeft = seconds;
                updateTimerUI();

                timerInterval = setInterval(function () {
                    timeLeft--;
                    updateTimerUI();

                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        timerDisplay.textContent = "EXPIRED";
                        timerDisplay.className = "fw-bold fw-mono text-danger";
                    }
                }, 1000);
            }

            function updateTimerUI() {
                if (timeLeft <= 0) return;
                const mins = Math.floor(timeLeft / 60);
                const secs = timeLeft % 60;
                timerDisplay.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            }

            startTimer(300);

            // Digits Navigation
            boxes.forEach((box, index) => {
                box.addEventListener('input', function (e) {
                    const val = e.target.value.replace(/[^0-9]/g, '');
                    e.target.value = val;

                    if (val && index < boxes.length - 1) {
                        boxes[index + 1].focus();
                    }
                    collectAndCheck();
                });

                box.addEventListener('keydown', function (e) {
                    if (e.key === 'Backspace' && !box.value && index > 0) {
                        boxes[index - 1].focus();
                    }
                });

                box.addEventListener('paste', function (e) {
                    e.preventDefault();
                    const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim().replace(/[^0-9]/g, '');
                    if (pasteData.length === 6) {
                        pasteData.split('').forEach((char, i) => {
                            if (boxes[i]) boxes[i].value = char;
                        });
                        boxes[5].focus();
                        collectAndCheck();
                    }
                });
            });

            function collectAndCheck() {
                const code = boxes.map(b => b.value).join('');
                hiddenInput.value = code;

                if (code.length === 6 && !isSubmitting) {
                    isSubmitting = true;
                    boxes.forEach(b => b.readOnly = true);
                    form.submit();
                }
            }

            form.addEventListener('submit', function (e) {
                const code = boxes.map(b => b.value).join('');
                hiddenInput.value = code;
                if (code.length !== 6) {
                    e.preventDefault();
                    alert("Please enter the complete 6-digit code.");
                } else {
                    isSubmitting = true;
                    boxes.forEach(b => b.readOnly = true);
                }
            });

            // Resend OTP Handler
            if (resendBtn) {
                resendBtn.addEventListener('click', function () {
                    const token = document.querySelector('#resendOtpForm input[name="__RequestVerificationToken"]').value;

                    resendBtn.disabled = true;
                    resendBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Sending...';

                    fetch('@Url.Action("RequestNextVaultOtp", "Vault")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            ajaxContainer.innerHTML = `
                                <div class="alert alert-success bg-success bg-opacity-10 border border-success border-opacity-25 text-success alert-dismissible fade show mb-4 rounded-3" role="alert">
                                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                                    <span class="small fw-semibold">${data.message}</span>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            `;

                            currentOtpSpan.textContent = data.otpCount;
                            boxes.forEach(b => { b.value = ''; b.readOnly = false; });
                            boxes[0].focus();
                            isSubmitting = false;

                            startTimer(300);

                            if (data.otpCount >= 3) {
                                resendBtn.disabled = true;
                                resendBtn.textContent = 'Maximum OTPs reached (3/3)';
                            } else {
                                resendBtn.disabled = false;
                                resendBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Request Next OTP';
                            }
                        } else {
                            ajaxContainer.innerHTML = `
                                <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
                                    <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                                    <span class="small fw-semibold">${data.message}</span>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            `;
                            resendBtn.disabled = false;
                            resendBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Request Next OTP';
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        resendBtn.disabled = false;
                        resendBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Request Next OTP';
                    });
                });
            }
        });
    </script>
}
