@{
    ViewData["Title"] = "Customer Dashboard";
    var account = ViewBag.Account as SmartBank.Entities.Account;
    var user = ViewBag.User as SmartBank.Entities.User;
    var recentTransactions = ViewBag.RecentTransactions as List<SmartBank.Entities.Transaction> ?? new List<SmartBank.Entities.Transaction>();
    decimal totalInflow = ViewBag.TotalInflow ?? 0m;
    decimal totalOutflow = ViewBag.TotalOutflow ?? 0m;
    bool isSuspended = ViewBag.IsSuspended ?? false;
    DateTime? lockedUntil = ViewBag.LockedUntil;

    var fullName = user?.FullName ?? "Customer";
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    if (string.IsNullOrEmpty(initials)) { initials = "SB"; }
}

<div class="container py-4">
    <!-- Top Greeting & Profile Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 52px; height: 52px; font-size: 1.25rem;">
                @initials
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h3 class="fw-bold text-dark mb-0">Welcome, @fullName</h3>
                    @if (account?.IsActive == true && !isSuspended)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                            <i class="bi bi-patch-check-fill me-1"></i> Verified Account
                        </span>
                    }
                    else if (isSuspended)
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill small">
                            <i class="bi bi-exclamation-octagon-fill me-1"></i> Account Suspended
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill small">
                            <i class="bi bi-snow2 me-1"></i> Account Frozen
                        </span>
                    }
                </div>
                <div class="text-muted small">
                    Username: <span class="fw-semibold text-dark">@@@user?.Username</span> • 
                    Email: <span class="fw-semibold text-dark">@user?.Email</span> • 
                    Phone: <span class="fw-semibold text-dark">@(user?.PhoneNumber ?? "Not provided")</span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                <i class="bi bi-pencil-square me-1"></i> Edit Profile
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                <i class="bi bi-shield-lock me-1"></i> Change Password
            </button>
        </div>
    </div>

    <!-- Suspension or Freeze Banner Warning -->
    @if (isSuspended)
    {
        <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-warning"></i>
            <div>
                <h6 class="fw-bold mb-1">Administrative Notice: Account Suspension</h6>
                <div class="small">
                    Your banking account is currently under administrative suspension.
                    @if (lockedUntil.HasValue && lockedUntil.Value > DateTime.UtcNow && lockedUntil.Value < DateTime.UtcNow.AddYears(10))
                    {
                        <span>Suspension is active until <strong>@lockedUntil.Value.ToString("MMM dd, yyyy HH:mm") UTC</strong>.</span>
                    }
                    Transactions (deposits, transfers, withdrawals) are temporarily disabled.
                </div>
            </div>
        </div>
    }
    else if (account?.IsActive == false)
    {
        <div class="alert alert-danger border-danger shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-snow fs-3 me-3 text-danger"></i>
            <div>
                <h6 class="fw-bold mb-1">Account Frozen</h6>
                <div class="small">
                    This account is currently marked as frozen. Debit and credit operations are restricted. Please contact customer support or bank administration.
                </div>
            </div>
        </div>
    }

    <!-- Main Dashboard Row: Debit Card & Metric Widgets -->
    <div class="row g-4 mb-4">
        <!-- 3D Debit Card -->
        <div class="col-lg-5 col-xl-4">
            <div class="smart-debit-card h-100 shadow-md">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="fs-4 fw-bold">Smart<span class="text-info">Bank</span></span>
                    <span class="badge bg-white-50 text-white rounded-pill px-3 py-1 small">PREMIER PLATINUM</span>
                </div>
                <div class="my-3">
                    <div class="card-chip mb-3"></div>
                    <div class="card-number" id="cardAccNumber">
                        @(account != null ? string.Join(" ", Enumerable.Range(0, (account.AccountNumber.Length + 3) / 4).Select(i => account.AccountNumber.Substring(i * 4, Math.Min(4, account.AccountNumber.Length - i * 4)))) : "•••• •••• •••• ••••")
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between align-items-end">
                        <div>
                            <div class="small opacity-75" style="font-size: 0.65rem;">CARDHOLDER</div>
                            <div class="card-holder text-truncate" style="max-width: 180px;">@fullName</div>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-light border-0 py-0 px-2" onclick="copyToClipboard('@(account?.AccountNumber)', this)">
                                <i class="bi bi-copy"></i> Copy Acc#
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial KPI Widgets -->
        <div class="col-lg-7 col-xl-8">
            <div class="row g-3">
                <!-- Available Balance Widget -->
                <div class="col-sm-6">
                    <div class="stat-widget h-100">
                        <div class="stat-icon-wrapper stat-icon-primary">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="text-muted small fw-semibold d-flex justify-content-between align-items-center">
                                <span>AVAILABLE BALANCE</span>
                                <button type="button" id="btnToggleBalance" class="btn btn-link btn-sm p-0 text-muted text-decoration-none small">
                                    <i class="bi bi-eye-slash"></i>
                                </button>
                            </div>
                            <div class="fs-3 fw-bold text-dark mt-1" id="valBalanceReal">
                                @(account != null ? $"৳{account.Balance:N2}" : "৳0.00")
                            </div>
                            <div class="fs-3 fw-bold text-dark mt-1 d-none font-monospace" id="valBalanceMasked">
                                ••••••••
                            </div>
                            <div class="small text-muted mt-1">
                                Account: <code class="text-primary fw-bold">@(account?.AccountNumber ?? "N/A")</code>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account Status Widget -->
                <div class="col-sm-6">
                    <div class="stat-widget h-100">
                        <div class="stat-icon-wrapper @(account?.IsActive == true && !isSuspended ? "stat-icon-success" : "stat-icon-danger")">
                            <i class="bi @(account?.IsActive == true && !isSuspended ? "bi-shield-check" : "bi-shield-exclamation")"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">ACCOUNT STATUS</div>
                            <div class="mt-1">
                                @if (account != null && account.IsActive && !isSuspended)
                                {
                                    <span class="badge-active">
                                        <i class="bi bi-check-circle-fill"></i> Active & Verified
                                    </span>
                                }
                                else if (isSuspended)
                                {
                                    <span class="badge-suspended">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Suspended
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-frozen">
                                        <i class="bi bi-snow2"></i> Frozen
                                    </span>
                                }
                            </div>
                            <div class="small text-muted mt-1">Tier: Tier 1 Standard Checking</div>
                        </div>
                    </div>
                </div>

                <!-- Total Inflow -->
                <div class="col-sm-6">
                    <div class="stat-widget h-100">
                        <div class="stat-icon-wrapper stat-icon-success">
                            <i class="bi bi-arrow-down-left"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">TOTAL INFLOW (CREDITS)</div>
                            <div class="fs-4 fw-bold text-success mt-1">
                                +৳@totalInflow.ToString("N2")
                            </div>
                            <div class="small text-muted mt-1">Deposits & Incoming Transfers</div>
                        </div>
                    </div>
                </div>

                <!-- Total Outflow -->
                <div class="col-sm-6">
                    <div class="stat-widget h-100">
                        <div class="stat-icon-wrapper stat-icon-danger">
                            <i class="bi bi-arrow-up-right"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">TOTAL OUTFLOW (DEBITS)</div>
                            <div class="fs-4 fw-bold text-danger mt-1">
                                -৳@totalOutflow.ToString("N2")
                            </div>
                            <div class="small text-muted mt-1">Withdrawals, Transfers & Bills</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Operations Navigation Grid -->
    <div class="mb-4">
        <h5 class="fw-bold text-dark mb-3">Quick Banking Operations</h5>
        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="Deposit" class="action-tile tile-deposit">
                    <i class="bi bi-arrow-down-circle-fill"></i>
                    <span>Deposit Money</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="Withdraw" class="action-tile tile-withdraw">
                    <i class="bi bi-arrow-up-circle-fill"></i>
                    <span>ATM Withdraw</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="Transfer" class="action-tile tile-transfer">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Fund Transfer</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="PayBill" class="action-tile tile-bills">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Pay Bills</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Loan" asp-action="Eligibility" class="action-tile tile-loan">
                    <i class="bi bi-cash-coin"></i>
                    <span>Loan Service</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="History" class="action-tile tile-history">
                    <i class="bi bi-clock-history"></i>
                    <span>History Log</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="Statement" class="action-tile tile-statement">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                    <span>Statement</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Transactions Table -->
    <div class="sb-card p-0 overflow-hidden mb-4">
        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark mb-0">
                <i class="bi bi-activity text-primary me-2"></i> Recent Account Activity
            </h6>
            <a asp-controller="Transaction" asp-action="History" class="btn btn-sm btn-outline-primary fw-semibold rounded-pill px-3">
                View Full History <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="table-responsive">
            <table class="table sb-table">
                <thead>
                    <tr>
                        <th>Transaction ID</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Timestamp</th>
                        <th>Related Account</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentTransactions != null && recentTransactions.Any())
                    {
                        @foreach (var tx in recentTransactions)
                        {
                            var isCredit = tx.Type == SmartBank.Entities.TransactionType.Deposit || tx.Type == SmartBank.Entities.TransactionType.TransferIn;
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">#TX-@tx.Id.ToString("D5")</span>
                                </td>
                                <td>
                                    @if (tx.Type == SmartBank.Entities.TransactionType.Deposit)
                                    {
                                        <span class="badge bg-success-subtle text-success"><i class="bi bi-arrow-down-left me-1"></i> Deposit</span>
                                    }
                                    else if (tx.Type == SmartBank.Entities.TransactionType.Withdraw)
                                    {
                                        <span class="badge bg-danger-subtle text-danger"><i class="bi bi-arrow-up-right me-1"></i> Withdrawal</span>
                                    }
                                    else if (tx.Type == SmartBank.Entities.TransactionType.TransferIn)
                                    {
                                        <span class="badge bg-info-subtle text-info"><i class="bi bi-arrow-down-left me-1"></i> Transfer In</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning"><i class="bi bi-arrow-up-right me-1"></i> Transfer Out</span>
                                    }
                                </td>
                                <td class="fw-bold @(isCredit ? "text-success" : "text-danger")">
                                    @(isCredit ? "+" : "-")৳@tx.Amount.ToString("N2")
                                </td>
                                <td class="text-muted small">
                                    @tx.Timestamp.ToString("MMM dd, yyyy HH:mm:ss")
                                </td>
                                <td class="small">
                                    @(tx.RelatedAccountId.HasValue ? $"Acc #{tx.RelatedAccountId.Value}" : "Self / Counter")
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Transaction" asp-action="Receipt" asp-route-id="@tx.Id" class="btn btn-sm btn-light border py-1 px-2 text-primary" title="View Receipt">
                                        <i class="bi bi-receipt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-2 d-block text-secondary mb-2"></i>
                                No recent transactions recorded yet. Make a deposit or transfer to get started!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-controller="Dashboard" asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="editProfileModalLabel">
                        <i class="bi bi-pencil-square text-primary me-2"></i> Edit Profile Information
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Full Legal Name</label>
                        <input type="text" name="fullName" class="form-control" value="@user?.FullName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Email Address</label>
                        <input type="email" name="email" class="form-control" value="@user?.Email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Phone Number</label>
                        <input type="tel" name="phoneNumber" class="form-control" value="@user?.PhoneNumber" placeholder="+880 1711-000000" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-controller="Dashboard" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="changePasswordModalLabel">
                        <i class="bi bi-shield-lock text-primary me-2"></i> Update Security Password
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Current Password</label>
                        <input type="password" name="currentPassword" class="form-control" placeholder="Enter current password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">New Password</label>
                        <input type="password" name="newPassword" class="form-control" placeholder="Minimum 8 characters" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Repeat new password" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>