@{
    ViewData["Title"] = "Dashboard";
    var account = Model as SmartBank.Entities.Account;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Welcome, @ViewBag.FullName</h2>
        <p class="text-muted mb-0">
            Email: <strong>@ViewBag.Email</strong> | 
            Phone: <strong>@(ViewBag.PhoneNumber ?? "Not set")</strong> | 
            Username: <strong>@ViewBag.Username</strong>
        </p>
    </div>
    <div>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
            ✏️ Edit Profile
        </button>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Dashboard" asp-action="UpdateProfile" method="post">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="editProfileModalLabel">✏️ Edit My Profile</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input type="text" name="fullName" class="form-control" value="@ViewBag.FullName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input type="email" name="email" class="form-control" value="@ViewBag.Email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input type="text" name="phoneNumber" class="form-control" value="@ViewBag.PhoneNumber" placeholder="+880 1711-000000" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3 shadow-sm">
            <div class="card-header">Account Balance</div>
            <div class="card-body">
                <h3 class="card-title">
                    @if (account != null)
                    {
                        @account.Balance.ToString("C")
                    }
                    else
                    {
                        <span>No account found</span>
                    }
                </h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3 shadow-sm">
            <div class="card-header">Account Number</div>
            <div class="card-body">
                <h4 class="card-title text-monospace"><code>@(account?.AccountNumber ?? "N/A")</code></h4>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3 shadow-sm">
            <div class="card-header">Account Status</div>
            <div class="card-body">
                @if (account != null)
                {
                    <h4>
                        <span class="badge @(account.IsActive ? "bg-success" : "bg-danger")">
                            @(account.IsActive ? "Active" : "Frozen")
                        </span>
                    </h4>
                }
                else
                {
                    <span class="badge bg-secondary">No Account</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mt-3 shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">Quick Operations</h5>
    </div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-6 col-md-3">
                <a asp-controller="Transaction" asp-action="Deposit" class="btn btn-outline-success w-100 py-3">
                    <i class="bi bi-arrow-down-circle"></i> Deposit Money
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Transaction" asp-action="Withdraw" class="btn btn-outline-danger w-100 py-3">
                    <i class="bi bi-arrow-up-circle"></i> Withdraw Money
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Transaction" asp-action="Transfer" class="btn btn-outline-warning w-100 py-3">
                    <i class="bi bi-arrow-left-right"></i> Transfer Funds
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Transaction" asp-action="History" class="btn btn-outline-info w-100 py-3">
                    <i class="bi bi-clock-history"></i> View History
                </a>
            </div>
        </div>
    </div>
</div>