@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "_Layout";

    var account = ViewBag.Account as SmartBank.Entities.Account;
    var user = ViewBag.User as SmartBank.Entities.User;
    bool isSuspended = ViewBag.IsSuspended ?? false;
    DateTime? lockedUntil = ViewBag.LockedUntil;

    var fullName = user?.FullName ?? "Customer";
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    if (string.IsNullOrEmpty(initials)) { initials = "SB"; }
}

<div class="container py-4">
    <!-- Top Greeting & Hero Profile Bar -->
    <div class="sb-card p-4 mb-4 shadow-lg border-top border-primary border-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-gradient text-white d-flex align-items-center justify-content-center fw-bold shadow-md" style="width: 58px; height: 58px; font-size: 1.35rem; border: 2px solid rgba(255,255,255,0.2);">
                    @initials
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h3 class="fw-bold text-white mb-0">Hello, @fullName</h3>
                        @if (account?.IsActive == true && !isSuspended)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                <i class="bi bi-patch-check-fill me-1"></i> Verified Account
                            </span>
                        }
                        else if (isSuspended)
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill small">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i> Account Suspended
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill small">
                                <i class="bi bi-snow2 me-1"></i> Account Frozen
                            </span>
                        }
                    </div>
                    <div class="text-muted small mt-1">
                        Username: <span class="fw-semibold text-white">@@@user?.Username</span> &bull; 
                        Email: <span class="fw-semibold text-white">@user?.Email</span> &bull; 
                        Account: <span class="fw-semibold text-info font-monospace">@(account?.AccountNumber ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Suspension or Freeze Banner Warning -->
    @if (isSuspended)
    {
        <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center mb-4" role="alert" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4) !important; color: #fde68a;">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-warning"></i>
            <div>
                <h6 class="fw-bold mb-1">Administrative Notice: Account Suspension</h6>
                <div class="small">
                    Your banking account is currently under administrative suspension.
                    @if (lockedUntil.HasValue && lockedUntil.Value > DateTime.UtcNow && lockedUntil.Value < DateTime.UtcNow.AddYears(10))
                    {
                        <span>Suspension is active until <strong>@lockedUntil.Value.ToString("MMM dd, yyyy HH:mm") UTC</strong>.</span>
                    }
                    Transactions (deposits, transfers, withdrawals) are temporarily disabled.
                </div>
            </div>
        </div>
    }
    else if (account?.IsActive == false)
    {
        <div class="alert alert-danger border-danger shadow-sm d-flex align-items-center mb-4" role="alert" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4) !important; color: #fecdd3;">
            <i class="bi bi-snow fs-3 me-3 text-danger"></i>
            <div>
                <h6 class="fw-bold mb-1">Account Frozen</h6>
                <div class="small">
                    This account is currently marked as frozen. Debit and credit operations are restricted. Please contact customer support or bank administration.
                </div>
            </div>
        </div>
    }

    <!-- Prominent "Open My Vault" Secure Hero Card -->
    <div class="sb-card p-4 p-md-5 mb-4 shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.98) 50%, rgba(30, 27, 75, 0.9) 100%); border: 1px solid rgba(99, 102, 241, 0.35);">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary bg-gradient px-3 py-1 rounded-pill small fw-bold">ENCRYPTED STORAGE</span>
                    <span class="badge bg-dark border border-secondary text-secondary rounded-pill small">Dual-Password Shield</span>
                </div>
                <h2 class="fw-bold text-white mb-2">
                    <i class="bi bi-safe2 text-info me-2"></i> SmartBank Financial Vault
                </h2>
                <p class="text-secondary mb-0" style="font-size: 1.05rem; line-height: 1.6;">
                    Your <strong>live account balance</strong>, <strong>platinum debit card details</strong>, and <strong>full itemized transaction history</strong> are securely stored in your personal Vault, protected with your dedicated Vault Password.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Vault" asp-action="Index" class="btn btn-sb-primary btn-lg rounded-pill px-4 py-3 fw-bold shadow-glow d-inline-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                    <span>Open My Vault &rarr;</span>
                </a>
                <div class="text-muted small mt-2">
                    <i class="bi bi-lock me-1"></i> Requires Security Vault Password
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Operations Navigation Grid -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-white mb-0">
                <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i> Banking Operations
            </h5>
            <span class="small text-muted">Instant &amp; OTP Protected</span>
        </div>

        <div class="row g-3">
            <!-- Deposit -->
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="Deposit" class="action-tile tile-deposit h-100">
                    <i class="bi bi-arrow-down-circle-fill"></i>
                    <span class="fw-bold">Deposit Money</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Add funds instantly</span>
                </a>
            </div>

            <!-- Withdraw -->
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="Withdraw" class="action-tile tile-withdraw h-100">
                    <i class="bi bi-arrow-up-circle-fill"></i>
                    <span class="fw-bold">ATM Cash Out</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Instant cash withdrawal</span>
                </a>
            </div>

            <!-- Transfer -->
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="Transfer" class="action-tile tile-transfer h-100">
                    <i class="bi bi-arrow-repeat"></i>
                    <span class="fw-bold">Fund Transfer</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Inter-account transfer</span>
                </a>
            </div>

            <!-- Pay Bills -->
            <div class="col-6 col-md-4 col-lg-3 col-xl">
                <a asp-controller="Transaction" asp-action="PayBill" class="action-tile tile-bills h-100">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span class="fw-bold">Pay Bills</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Utilities &amp; services</span>
                </a>
            </div>

            <!-- Loan Service -->
            <div class="col-6 col-md-4 col-lg col-xl">
                <a asp-controller="Loan" asp-action="Eligibility" class="action-tile tile-loan h-100">
                    <i class="bi bi-cash-coin"></i>
                    <span class="fw-bold">Loan Service</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Credit eligibility &amp; apply</span>
                </a>
            </div>
        </div>
    </div>
</div>