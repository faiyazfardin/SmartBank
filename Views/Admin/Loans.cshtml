@model List<SmartBank.DTOs.Loans.LoanApplicationDto>
@{
    ViewData["Title"] = "Admin Loan Review Center";
    var stats = ViewBag.Stats as SmartBank.DTOs.Loans.AdminLoanStatsDto ?? new SmartBank.DTOs.Loans.AdminLoanStatsDto();
    var currentStatus = ViewBag.CurrentStatus as string ?? "";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<div class="container-fluid py-4 px-lg-4" style="max-width: 1400px;">
    <!-- Top Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-extrabold text-white mb-0">Loan Applications Governance</h3>
                <span class="badge bg-danger rounded-pill px-3 py-1 small fw-bold">Admin Command</span>
            </div>
            <p class="text-secondary small mb-0 mt-1">
                Evaluate customer loan submissions, inspect automated rule scores, and execute underwriting approvals or rejections.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-people-fill me-1"></i> User Directory
            </a>
            <a asp-controller="Admin" asp-action="Loans" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh List
            </a>
        </div>
    </div>

    <!-- 4-Stat Metric Summary Bar -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget h-100">
                <div class="stat-icon-wrapper stat-icon-primary">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">TOTAL APPLICATIONS</div>
                    <div class="fs-4 fw-bold text-white mt-1">@stats.TotalApplications</div>
                    <div class="small text-muted">All-time submissions</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget h-100">
                <div class="stat-icon-wrapper stat-icon-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">PENDING REVIEW</div>
                    <div class="fs-4 fw-bold text-warning mt-1">@stats.PendingCount</div>
                    <div class="small text-muted">Requires admin decision</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget h-100">
                <div class="stat-icon-wrapper stat-icon-success">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">APPROVED LOANS</div>
                    <div class="fs-4 fw-bold text-success mt-1">@stats.ApprovedCount</div>
                    <div class="small text-muted">Total: ৳@stats.TotalApprovedAmount.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget h-100">
                <div class="stat-icon-wrapper stat-icon-danger">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">REJECTED APPLICATIONS</div>
                    <div class="fs-4 fw-bold text-danger mt-1">@stats.RejectedCount</div>
                    <div class="small text-muted">Denied under risk policy</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="sb-card p-3 mb-4">
        <form asp-controller="Admin" asp-action="Loans" method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control bg-dark text-white border-secondary" placeholder="Search application #, customer name, email, account..." />
                </div>
            </div>

            <div class="col-md-4">
                <select name="statusFilter" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(currentStatus))">All Statuses (@stats.TotalApplications)</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Pending Review Only (@stats.PendingCount)</option>
                    <option value="Approved" selected="@(currentStatus == "Approved")">Approved Loans Only (@stats.ApprovedCount)</option>
                    <option value="Rejected" selected="@(currentStatus == "Rejected")">Rejected Only (@stats.RejectedCount)</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1">Filter</button>
                <a asp-controller="Admin" asp-action="Loans" class="btn btn-outline-secondary rounded-pill px-3">Reset</a>
            </div>
        </form>
    </div>

    <!-- Loan Applications Table Card -->
    <div class="sb-card p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-white mb-0">
                <i class="bi bi-table text-primary me-2"></i> Application Records (@(Model?.Count ?? 0))
            </h6>
        </div>

        <div class="table-responsive">
            <table class="table sb-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Application #</th>
                        <th>Customer</th>
                        <th>Account</th>
                        <th>Loan Type</th>
                        <th>Requested</th>
                        <th>Score / Cap</th>
                        <th>Status</th>
                        <th>Submitted Date</th>
                        <th class="text-end">Underwriting Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-dark border font-monospace text-info">@app.ApplicationNumber</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-white">@app.CustomerName</div>
                                    <div class="text-muted small" style="font-size: 0.75rem;">@app.CustomerEmail</div>
                                </td>
                                <td>
                                    <code class="text-info">@app.AccountNumber</code>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                        @app.LoanType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-success fs-6">৳@app.RequestedAmount.ToString("N2")</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge @(app.EligibilityScore >= 80 ? "bg-success-subtle text-success" : app.EligibilityScore >= 65 ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning") rounded-pill">
                                            @app.EligibilityScore pts
                                        </span>
                                        <span class="text-muted small" style="font-size: 0.72rem;">(Cap: ৳@app.EligibleAmount.ToString("N0"))</span>
                                    </div>
                                </td>
                                <td>
                                    @if (app.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approved
                                        </span>
                                    }
                                    else if (app.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @app.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-controller="Loan" asp-action="Details" asp-route-applicationNumber="@app.ApplicationNumber" class="btn btn-sm btn-outline-info rounded-pill px-2 me-1" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        @if (app.Status == "Pending")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 me-1" data-bs-toggle="modal" data-bs-target="#approveModal-@app.Id">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" data-bs-toggle="modal" data-bs-target="#rejectModal-@app.Id">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        }
                                    </div>

                                    <!-- Approve Modal -->
                                    @if (app.Status == "Pending")
                                    {
                                        <div class="modal fade" id="approveModal-@app.Id" tabindex="-1" aria-labelledby="approveModalLabel-@app.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content bg-dark border-secondary text-start">
                                                    <div class="modal-header border-secondary">
                                                        <h5 class="modal-title text-white" id="approveModalLabel-@app.Id">
                                                            <i class="bi bi-check-circle text-success me-2"></i> Approve Loan @app.ApplicationNumber
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-controller="Admin" asp-action="ApproveLoan" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="applicationNumber" value="@app.ApplicationNumber" />
                                                        <div class="modal-body">
                                                            <div class="p-3 rounded-3 bg-dark border border-secondary mb-3">
                                                                <div class="d-flex justify-content-between text-muted small">
                                                                    <span>Applicant: <strong class="text-white">@app.CustomerName</strong></span>
                                                                    <span>Amount: <strong class="text-success">৳@app.RequestedAmount.ToString("N2")</strong></span>
                                                                </div>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label text-white small fw-bold">APPROVAL COMMENT / NOTE</label>
                                                                <textarea name="comment" rows="3" class="form-control bg-dark text-white border-secondary" placeholder="Eligibility requirements satisfied. Approved for credit disbursement." required>Eligibility requirements satisfied.</textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-secondary">
                                                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success rounded-pill px-4">Confirm Approval</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Reject Modal -->
                                        <div class="modal fade" id="rejectModal-@app.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@app.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content bg-dark border-secondary text-start">
                                                    <div class="modal-header border-secondary">
                                                        <h5 class="modal-title text-white" id="rejectModalLabel-@app.Id">
                                                            <i class="bi bi-x-circle text-danger me-2"></i> Reject Loan @app.ApplicationNumber
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-controller="Admin" asp-action="RejectLoan" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="applicationNumber" value="@app.ApplicationNumber" />
                                                        <div class="modal-body">
                                                            <div class="p-3 rounded-3 bg-dark border border-secondary mb-3">
                                                                <div class="d-flex justify-content-between text-muted small">
                                                                    <span>Applicant: <strong class="text-white">@app.CustomerName</strong></span>
                                                                    <span>Amount: <strong class="text-danger">৳@app.RequestedAmount.ToString("N2")</strong></span>
                                                                </div>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label text-white small fw-bold">REJECTION REASON</label>
                                                                <textarea name="comment" rows="3" class="form-control bg-dark text-white border-secondary" placeholder="Eligibility requirements not satisfied." required>Eligibility requirements not satisfied.</textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-secondary">
                                                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Rejection</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No loan applications found matching the selected filter.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
