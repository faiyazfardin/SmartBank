<!-- Modal 4: Provision Bank Account -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-controller="Admin" asp-action="CreateAccount" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="accUserId" name="userId" />

                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="createAccountModalLabel">
                        <i class="bi bi-bank text-success me-2"></i> Provision Bank Account
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-secondary mb-3">
                        Provisioning new bank account for <strong id="accUserName" class="text-white">User</strong>.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Opening Deposit (৳)</label>
                        <input type="number" name="initialBalance" class="form-control fw-bold text-success fs-5" value="1000.00" min="0" step="0.01" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">Provision</button>
                </div>
            </form>
        </div>
    </div>
</div>
