@model List<SmartBank.Entities.User>
@{
    ViewData["Title"] = "Admin Command Center";
    int totalUsers = ViewBag.TotalUsers ?? 0;
    int totalAccounts = ViewBag.TotalAccounts ?? 0;
    decimal totalSystemBalance = ViewBag.TotalSystemBalance ?? 0m;
    int totalTransactionsCount = ViewBag.TotalTransactionsCount ?? 0;
    decimal totalTransactionVolume = ViewBag.TotalTransactionVolume ?? 0m;
    int suspendedUsersCount = ViewBag.SuspendedUsersCount ?? 0;
    int pendingUsersCount = ViewBag.PendingUsersCount ?? 0;
    var pendingUsers = ViewBag.PendingUsers as List<SmartBank.Entities.User> ?? new List<SmartBank.Entities.User>();
    var auditTransactions = ViewBag.AuditTransactions as List<SmartBank.Entities.Transaction> ?? new List<SmartBank.Entities.Transaction>();

    string search = ViewBag.Search as string ?? "";
    string roleFilter = ViewBag.RoleFilter as string ?? "";
    string statusFilter = ViewBag.StatusFilter as string ?? "";

    // Vibrant Avatar Gradient Array
    string[] avatarGradients = new[] {
        "linear-gradient(135deg, #6366f1, #8b5cf6)",
        "linear-gradient(135deg, #ec4899, #f43f5e)",
        "linear-gradient(135deg, #10b981, #06b6d4)",
        "linear-gradient(135deg, #f59e0b, #ea580c)",
        "linear-gradient(135deg, #8b5cf6, #3b82f6)",
        "linear-gradient(135deg, #14b8a6, #0284c7)"
    };
}

<style>
    .sb-table-compact th, .sb-table-compact td {
        padding: 0.35rem 0.25rem !important;
        vertical-align: middle !important;
        font-size: 0.76rem;
    }
    .action-btn-sm {
        width: 25px !important;
        height: 25px !important;
        font-size: 0.68rem !important;
        padding: 0 !important;
        flex-shrink: 0;
    }
    .avatar-sm-compact {
        width: 28px !important;
        height: 28px !important;
        font-size: 0.75rem !important;
        flex-shrink: 0;
    }
</style>

<div class="container-fluid px-lg-3 py-4">
    <!-- Top Header -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4 pb-3 border-bottom">
        <h3 class="fw-extrabold text-dark mb-0">Admin Command Center</h3>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-dark rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#auditLogModal" style="background: #1e293b; border-color: #334155;">
                <i class="bi bi-journal-code text-info"></i>
                <span>Audit Log</span>
            </button>
            <button type="button" class="btn text-white rounded-pill px-4 fw-bold shadow d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createUserModal" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); border: none;">
                <i class="bi bi-person-plus-fill"></i>
                <span>+ Create User</span>
            </button>
        </div>
    </div>

    <!-- Colorful Clean KPI Metrics Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Users -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget rounded-4 p-3 h-100 d-flex align-items-center" style="border-left: 4px solid #6366f1 !important;">
                <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm flex-shrink-0" style="width: 52px; height: 52px; background: linear-gradient(135deg, #6366f1, #8b5cf6);">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div class="ms-3">
                    <div class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Total Users</div>
                    <div class="fs-3 fw-extrabold text-white mt-1">@totalUsers.ToString("N0")</div>
                </div>
            </div>
        </div>

        <!-- Card 2: KYC Approvals -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget rounded-4 p-3 h-100 d-flex align-items-center" style="border-left: 4px solid #f59e0b !important;">
                <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm flex-shrink-0" style="width: 52px; height: 52px; background: linear-gradient(135deg, #f59e0b, #ea580c);">
                    <i class="bi bi-person-vcard-fill fs-4"></i>
                </div>
                <div class="ms-3">
                    <div class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.5px;">KYC Queue</div>
                    <div class="fs-3 fw-extrabold text-warning mt-1">@pendingUsersCount.ToString("N0")</div>
                </div>
            </div>
        </div>

        <!-- Card 3: Vault Balance -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget rounded-4 p-3 h-100 d-flex align-items-center" style="border-left: 4px solid #10b981 !important;">
                <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm flex-shrink-0" style="width: 52px; height: 52px; background: linear-gradient(135deg, #10b981, #06b6d4);">
                    <i class="bi bi-safe2-fill fs-4"></i>
                </div>
                <div class="ms-3">
                    <div class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Vault Assets</div>
                    <div class="fs-3 fw-extrabold text-success mt-1">৳@totalSystemBalance.ToString("N2")</div>
                </div>
            </div>
        </div>

        <!-- Card 4: Volume -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget rounded-4 p-3 h-100 d-flex align-items-center" style="border-left: 4px solid #8b5cf6 !important;">
                <div class="rounded-4 d-flex align-items-center justify-content-center text-white shadow-sm flex-shrink-0" style="width: 52px; height: 52px; background: linear-gradient(135deg, #8b5cf6, #ec4899);">
                    <i class="bi bi-arrow-left-right fs-4"></i>
                </div>
                <div class="ms-3">
                    <div class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Volume</div>
                    <div class="fs-3 fw-extrabold text-info mt-1">৳@totalTransactionVolume.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Registration / NID Review Requests Section (Rendered when pending requests exist) -->
    @if (pendingUsers != null && pendingUsers.Any())
    {
        <div class="sb-card mb-4 rounded-4 overflow-hidden" style="border: 1px solid rgba(245, 158, 11, 0.35) !important;">
            <div class="d-flex align-items-center justify-content-between p-3" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.1) 100%); border-bottom: 1px solid rgba(245, 158, 11, 0.2);">
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 32px; height: 32px; background: linear-gradient(135deg, #f59e0b, #d97706);">
                        <i class="bi bi-person-vcard fs-6"></i>
                    </span>
                    <h5 class="fw-bold mb-0 text-white">KYC Registration & NID Approval Requests</h5>
                </div>
                <span class="badge rounded-pill px-3 py-1-5 fw-bold shadow-sm text-white" style="background: linear-gradient(135deg, #f59e0b, #ea580c);">
                    @pendingUsers.Count Pending
                </span>
            </div>

            <div class="table-responsive">
                <table class="table sb-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Applicant</th>
                            <th>Contact</th>
                            <th>National ID (NID)</th>
                            <th>Submitted</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < pendingUsers.Count; i++)
                        {
                            var p = pendingUsers[i];
                            var pAcc = p.Accounts.FirstOrDefault();
                            var grad = avatarGradients[i % avatarGradients.Length];
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px; background: @grad;">
                                            @(p.FullName.Length > 0 ? p.FullName.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">@p.FullName</div>
                                            <div class="text-secondary small font-monospace">@@@p.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-white fw-semibold">@p.Email</div>
                                    <div class="text-secondary small">@(p.PhoneNumber ?? "—")</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill px-3 py-1 font-monospace fw-bold shadow-sm" style="background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.5) !important; color: #fbbf24 !important; font-size: 0.85rem;">
                                        <i class="bi bi-card-heading me-1 text-warning"></i>@(p.NidNumber ?? "Not Provided")
                                    </span>
                                </td>
                                <td>
                                    <div class="small text-white fw-semibold">@p.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    <div class="text-secondary small">@p.CreatedAt.ToString("hh:mm tt") UTC</div>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Approve Form -->
                                        <form asp-controller="Admin" asp-action="ApproveUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm text-white fw-bold rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1" style="background: linear-gradient(135deg, #10b981, #059669); border: none;">
                                                <i class="bi bi-check-circle-fill"></i>
                                                <span>Approve</span>
                                            </button>
                                        </form>

                                        <!-- Reject Form -->
                                        <form asp-controller="Admin" asp-action="RejectUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning fw-semibold rounded-pill px-3" title="Reject Request">
                                                <i class="bi bi-x-circle me-1"></i> Reject
                                            </button>
                                        </form>

                                        <!-- Delete Trigger Button -->
                                        <button type="button" class="btn btn-sm btn-outline-danger fw-semibold rounded-pill px-3" title="Delete Applicant Request"
                                                onclick="openDeleteModal(@p.Id, '@p.FullName', '@p.Username', '@p.Role', '@(p.NidNumber ?? "")', '@(pAcc?.AccountNumber ?? "")', @(pAcc?.Balance ?? 0))">
                                            <i class="bi bi-trash3 me-1"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Filter & Search Bar -->
    <div class="sb-card p-3 mb-4 rounded-4">
        <form asp-controller="Admin" asp-action="Users" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 rounded-end-pill" placeholder="Search by name, username, email, phone, NID or account number..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="roleFilter" class="form-select rounded-pill">
                    <option value="">All Roles</option>
                    <option value="Customer" selected="@(roleFilter == "Customer")">Customer Accounts</option>
                    <option value="Admin" selected="@(roleFilter == "Admin")">Admin Accounts</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="statusFilter" class="form-select rounded-pill">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(statusFilter == "Active")">Active</option>
                    <option value="Pending" selected="@(statusFilter == "Pending")">Pending</option>
                    <option value="Suspended" selected="@(statusFilter == "Suspended")">Suspended</option>
                    <option value="Rejected" selected="@(statusFilter == "Rejected")">Rejected</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn text-white w-100 fw-bold rounded-pill shadow-sm" style="background: linear-gradient(135deg, #4f46e5, #6366f1); border: none;">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(roleFilter) || !string.IsNullOrEmpty(statusFilter))
                {
                    <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary rounded-pill" title="Clear Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Users Directory Data Table -->
    <div class="sb-card p-0 overflow-hidden rounded-4">
        <div class="p-3 bg-light d-flex align-items-center justify-content-between border-bottom">
            <h5 class="fw-bold text-white mb-0">User Directory</h5>
        </div>
        <div class="table-responsive">
            <table class="table sb-table sb-table-compact mb-0 align-middle">
                <thead>
                    <tr>
                        <th>User Profile</th>
                        <th>Contact</th>
                        <th>NID Number</th>
                        <th>Role</th>
                        <th>Account #</th>
                        <th>Balance</th>
                        <th>Risk Score</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var u = Model[i];
                            var acc = u.Accounts.FirstOrDefault();
                            var isLocked = u.LockedUntil.HasValue && u.LockedUntil.Value > DateTime.UtcNow;
                            var isSuspended = u.Status?.Equals("Suspended", StringComparison.OrdinalIgnoreCase) == true;
                            var isPending = u.Status?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true;
                            var isRejected = u.Status?.Equals("Rejected", StringComparison.OrdinalIgnoreCase) == true;
                            var grad = u.Role == "Admin" ? "linear-gradient(135deg, #ef4444, #dc2626)" : avatarGradients[i % avatarGradients.Length];

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-1.5">
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm avatar-sm-compact" style="background: @grad;">
                                            @(u.FullName.Length > 0 ? u.FullName.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                        <div style="min-width: 0;">
                                            <div class="fw-bold text-white text-truncate" style="max-width: 115px;" title="@u.FullName">@u.FullName</div>
                                            <div class="text-secondary small font-monospace text-truncate" style="max-width: 115px; font-size: 0.72rem;">@@@u.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="min-width: 0;">
                                        <div class="text-white fw-semibold text-truncate" style="max-width: 125px; font-size: 0.75rem;" title="@u.Email">@u.Email</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">@(u.PhoneNumber ?? "—")</div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(u.NidNumber))
                                    {
                                        <span class="badge rounded-pill px-2 py-0.5 font-monospace fw-bold shadow-sm" style="background: rgba(6, 182, 212, 0.2); border: 1px solid rgba(6, 182, 212, 0.45) !important; color: #38bdf8 !important; font-size: 0.72rem;">
                                            <i class="bi bi-card-text me-1 text-info"></i>@u.NidNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small font-monospace">—</span>
                                    }
                                </td>
                                <td>
                                    @if (u.Role == "Admin")
                                    {
                                        <span class="badge rounded-pill px-2 py-0.5 text-white fw-bold shadow-sm" style="background: linear-gradient(135deg, #ef4444, #dc2626); font-size: 0.68rem;">ADMIN</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-2 py-0.5 bg-secondary bg-opacity-20 text-light border border-secondary border-opacity-30 font-semibold" style="font-size: 0.68rem;">Customer</span>
                                    }
                                </td>
                                <td>
                                    @if (acc != null)
                                    {
                                        <div class="font-monospace fw-bold text-white d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                            <span>@acc.AccountNumber</span>
                                            <button type="button" class="btn btn-sm btn-link p-0 text-secondary hover-white" onclick="copyToClipboard('@acc.AccountNumber', this)" title="Copy Account #">
                                                <i class="bi bi-copy" style="font-size: 0.7rem;"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill" style="font-size: 0.7rem;" onclick="openCreateAccountModal(@u.Id, '@u.FullName')">
                                            <i class="bi bi-plus-circle me-1"></i> Provision Acc
                                        </button>
                                    }
                                </td>
                                <td class="fw-bold text-success" style="font-size: 0.78rem;">
                                    @(acc != null ? $"৳{acc.Balance:N2}" : "—")
                                </td>
                                <td>
                                    @{
                                        var score = u.RiskScore;
                                        string scoreClass = score <= 30 ? "bg-success text-white" :
                                                            score <= 60 ? "bg-warning text-dark" :
                                                            score <= 80 ? "bg-warning text-white" : "bg-danger text-white";
                                        string scoreStyle = (score > 60 && score <= 80) ? "background: #f97316; color: white;" : "";
                                    }
                                    <span class="badge rounded-pill px-2 py-0.5 fw-bold @(score <= 80 && score > 60 ? "" : scoreClass)" style="@scoreStyle font-size: 0.72rem;">
                                        <i class="bi bi-activity me-1"></i>@score pts
                                    </span>
                                </td>
                                <td>
                                    @if (isPending)
                                    {
                                        <span class="badge rounded-pill px-2 py-0.5 fw-bold shadow-sm d-inline-flex align-items-center gap-1" style="background: rgba(245, 158, 11, 0.22); border: 1px solid rgba(245, 158, 11, 0.55) !important; color: #fbbf24 !important; font-size: 0.72rem;">
                                            <i class="bi bi-hourglass-split text-warning"></i> Pending
                                        </span>
                                    }
                                    else if (isRejected)
                                    {
                                        <span class="badge rounded-pill px-2 py-0.5 bg-danger text-white" style="font-size: 0.72rem;">
                                            <i class="bi bi-x-circle me-1"></i> Rejected
                                        </span>
                                    }
                                    else if (isSuspended)
                                    {
                                        <span class="badge-suspended" style="font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                            <i class="bi bi-exclamation-octagon-fill"></i> Suspended
                                        </span>
                                    }
                                    else if (acc != null && !acc.IsActive)
                                    {
                                        <span class="badge-frozen" style="font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                            <i class="bi bi-snow2"></i> Frozen
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-active" style="font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                            <i class="bi bi-check-circle-fill"></i> Active
                                        </span>
                                    }

                                    @if (u.FailedLoginCount > 0)
                                    {
                                        <div class="mt-0.5">
                                            <span class="badge rounded-pill px-1.5 py-0.5 text-warning bg-warning bg-opacity-10 border border-warning border-opacity-25" style="font-size: 0.65rem;" title="@u.FailedLoginCount failed login password attempt(s)">
                                                <i class="bi bi-exclamation-triangle-fill me-0.5"></i>@u.FailedLoginCount Failed Login@(u.FailedLoginCount > 1 ? "s" : "")
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="text-end" style="white-space: nowrap; width: 1%;">
                                    <div class="d-inline-flex align-items-center gap-1 flex-nowrap">
                                        @if (isPending)
                                        {
                                            <form asp-controller="Admin" asp-action="ApproveUser" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.Id" />
                                                <button type="submit" class="btn btn-sm text-white rounded-circle p-0 d-inline-flex align-items-center justify-content-center shadow-sm action-btn-sm" style="background: #10b981;" title="Approve Request">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- View Details, History & Add Money Button -->
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-circle p-0 d-inline-flex align-items-center justify-content-center action-btn-sm" title="View Profile & Deposit Money" 
                                                onclick="openUserDetailsModal(@u.Id)">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>

                                        <!-- Edit User Button -->
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-circle p-0 d-inline-flex align-items-center justify-content-center action-btn-sm" title="Edit User" 
                                                onclick="openEditUserModal(@u.Id, '@u.FullName', '@u.Username', '@u.Email', '@(u.PhoneNumber ?? "")', '@(u.NidNumber ?? "")', '@u.Role', '@u.Status', '@(acc?.AccountNumber ?? "")', @(acc?.IsActive == true ? "true" : "false"))">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <!-- Freeze / Unfreeze Toggle Button -->
                                        @if (acc != null)
                                        {
                                            <form asp-controller="Admin" asp-action="ToggleAccountStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="accountId" value="@acc.Id" />
                                                <button type="submit" class="btn btn-sm @(acc.IsActive ? "btn-outline-info text-dark" : "btn-outline-success") rounded-circle p-0 d-inline-flex align-items-center justify-content-center action-btn-sm" title="@(acc.IsActive ? "Freeze Account" : "Unfreeze Account")">
                                                    <i class="bi @(acc.IsActive ? "bi-snow" : "bi-sun-fill")"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- Suspend / Lockout Button -->
                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-circle p-0 d-inline-flex align-items-center justify-content-center action-btn-sm" title="@(isSuspended ? "Unsuspend User" : "Suspend User")" onclick="openSuspendModal(@u.Id, '@u.FullName.Replace("'", "\\'")', @(isSuspended ? "true" : "false"))">
                                            <i class="bi @(isSuspended ? "bi-unlock-fill" : "bi-lock-fill")"></i>
                                        </button>

                                        <!-- Admin Override Vault Password Button (PART E) -->
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-circle p-0 d-inline-flex align-items-center justify-content-center action-btn-sm" title="Override Vault Password" onclick="openOverrideVaultModal(@u.Id, '@u.FullName')">
                                            <i class="bi bi-shield-lock-fill"></i>
                                        </button>

                                        <!-- Delete Trigger Button -->
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-inline-flex align-items-center justify-content-center action-btn-sm" title="Delete User" 
                                                onclick="openDeleteModal(@u.Id, '@u.FullName', '@u.Username', '@u.Role', '@(u.NidNumber ?? "")', '@(acc?.AccountNumber ?? "")', @(acc?.Balance ?? 0))">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-people fs-1 d-block text-secondary mb-2"></i>
                                No users found.
                                             </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Render Modular Modal Dialogs -->
<partial name="Modals/_DeleteUserModal" />
<partial name="Modals/_CreateUserModal" />
<partial name="Modals/_EditUserModal" />
<partial name="Modals/_SuspendUserModal" />
<partial name="Modals/_CreateAccountModal" />
<partial name="Modals/_AuditLogModal" />
<partial name="Modals/_UserDetailsModal" />
<partial name="Modals/_OverrideVaultModal" />
<partial name="Modals/_AdjustRiskScoreModal" />

@section Scripts {
<script>
    let editModalInstance = null;
    let deleteModalInstance = null;
    let userDetailsModalInstance = null;
    let currentViewingUserId = 0;

    document.addEventListener('DOMContentLoaded', () => {
        const editEl = document.getElementById('editUserModal');
        if (editEl) editModalInstance = new bootstrap.Modal(editEl);

        const delEl = document.getElementById('deleteUserModal');
        if (delEl) deleteModalInstance = new bootstrap.Modal(delEl);

        const udEl = document.getElementById('userDetailsModal');
        if (udEl) userDetailsModalInstance = new bootstrap.Modal(udEl);
    });

    function openUserDetailsModal(userId) {
        currentViewingUserId = userId;
        const tbody = document.getElementById('udTxTableBody');
        tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>Loading user information & ledger...</td></tr>`;

        const alertDiv = document.getElementById('udDepositAlert');
        if (alertDiv) alertDiv.className = 'alert d-none small py-2 px-3 mb-2';

        document.getElementById('udDepositAmount').value = '';
        document.getElementById('udDepositRef').value = '';

        if (userDetailsModalInstance) userDetailsModalInstance.show();

        fetch(`/Admin/GetUserDetails?userId=${userId}`)
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    tbody.innerHTML = `<tr><td colspan="5" class="text-center text-danger py-4">${data.message || 'Failed to load user profile'}</td></tr>`;
                    return;
                }

                const u = data.user;
                document.getElementById('udModalFullName').innerText = u.fullName;
                document.getElementById('udModalUsername').innerText = '@@' + u.username;
                document.getElementById('udModalEmail').innerText = u.email;
                document.getElementById('udModalPhone').innerText = u.phoneNumber;
                document.getElementById('udModalNid').innerText = u.nidNumber;
                document.getElementById('udModalUserId').innerText = '#' + u.id;
                document.getElementById('udModalCreatedAt').innerText = u.createdAt;
                document.getElementById('udModalAccNum').innerText = u.accountNumber;
                document.getElementById('udModalBalance').innerText = '৳' + Number(u.balance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('udModalAvatar').innerText = u.fullName.length > 0 ? u.fullName.substring(0, 1).toUpperCase() : 'U';

                // Failed Attempt Counters
                const failedLogin = u.failedLoginCount || 0;
                const failedVault = u.failedVaultAttempts || 0;
                const loginEl = document.getElementById('udModalFailedLogin');
                if (loginEl) {
                    loginEl.innerHTML = failedLogin > 0 
                        ? `<span class="badge bg-warning text-dark px-2 py-0.5 rounded-pill"><i class="bi bi-exclamation-triangle-fill me-1"></i>${failedLogin} / 5 Attempts</span>` 
                        : `<span class="text-success fw-bold">0 Attempts Clean</span>`;
                }
                const vaultEl = document.getElementById('udModalFailedVault');
                if (vaultEl) {
                    vaultEl.innerHTML = failedVault > 0 
                        ? `<span class="badge bg-danger text-white px-2 py-0.5 rounded-pill"><i class="bi bi-shield-slash-fill me-1"></i>${failedVault} / 3 Attempts</span>` 
                        : `<span class="text-success fw-bold">0 Attempts Clean</span>`;
                }

                // Role & Status badges
                const roleBadge = document.getElementById('udModalRoleBadge');
                roleBadge.innerText = u.role;
                roleBadge.style.background = u.role === 'Admin' ? '#ef4444' : '#6366f1';

                const statusBadge = document.getElementById('udModalStatusBadge');
                statusBadge.innerText = u.status;
                if (u.status === 'Active') {
                    statusBadge.className = 'badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2.5 py-1 fw-bold small';
                } else if (u.status === 'Suspended') {
                    statusBadge.className = 'badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1 fw-bold small';
                } else {
                    statusBadge.className = 'badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 fw-bold small';
                }

                const accStatus = document.getElementById('udModalAccStatus');
                accStatus.innerText = u.isActive ? 'Active' : 'Frozen';
                accStatus.className = u.isActive ? 'badge rounded-pill bg-success px-3 py-1 fw-bold small' : 'badge rounded-pill bg-danger px-3 py-1 fw-bold small';

                // Risk Score & Actions
                const score = u.riskScore || 0;
                document.getElementById('udModalRiskScoreVal').innerText = score + ' pts';
                const riskBadge = document.getElementById('udModalRiskBadge');
                
                if (score <= 30) {
                    riskBadge.innerText = `${score} pts (Low Risk)`;
                    riskBadge.className = 'badge rounded-pill bg-success text-white px-3 py-1 fw-bold small';
                } else if (score <= 60) {
                    riskBadge.innerText = `${score} pts (Medium Risk)`;
                    riskBadge.className = 'badge rounded-pill bg-warning text-dark px-3 py-1 fw-bold small';
                } else if (score <= 80) {
                    riskBadge.innerText = `${score} pts (High Risk)`;
                    riskBadge.className = 'badge rounded-pill text-white px-3 py-1 fw-bold small';
                    riskBadge.style.background = '#f97316';
                } else {
                    riskBadge.innerText = `${score} pts (FROZEN >80)`;
                    riskBadge.className = 'badge rounded-pill bg-danger text-white px-3 py-1 fw-bold small';
                }

                document.getElementById('udUnfreezeUserId').value = u.id;
                const unfreezeBtn = document.getElementById('udBtnUnfreeze');
                if (u.status === 'Suspended' || score > 80 || !u.isActive) {
                    unfreezeBtn.classList.remove('d-none');
                } else {
                    unfreezeBtn.classList.add('d-none');
                }

                // Render Transactions & Risk Events
                renderUserTransactions(data.transactions);
                renderRiskEvents(data.riskEvents);
            })
            .catch(err => {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center text-danger py-4">Error communicating with server.</td></tr>`;
            });
    }

    function renderUserTransactions(transactions) {
        const tbody = document.getElementById('udTxTableBody');
        if (!transactions || transactions.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block text-secondary mb-1"></i>No transaction records found for this account.</td></tr>`;
            return;
        }

        let html = '';
        transactions.forEach(t => {
            const isCredit = t.isCredit;
            let typeBadge = '';
            if (t.type === 'Deposit') {
                typeBadge = '<span class="badge-active py-0.5 px-2"><i class="bi bi-arrow-down-left"></i> Deposit</span>';
            } else if (t.type === 'Withdraw') {
                typeBadge = '<span class="badge-frozen py-0.5 px-2"><i class="bi bi-arrow-up-right"></i> Withdrawal</span>';
            } else if (t.type === 'TransferIn') {
                typeBadge = '<span class="badge-transfer-in py-0.5 px-2"><i class="bi bi-arrow-down-left"></i> Transfer In</span>';
            } else {
                typeBadge = '<span class="badge-suspended py-0.5 px-2"><i class="bi bi-arrow-up-right"></i> Transfer Out</span>';
            }

            html += `<tr>
                <td class="font-monospace fw-bold text-info">#TX-${String(t.id).padStart(6, '0')}</td>
                <td>${typeBadge}</td>
                <td class="font-monospace fw-bold ${isCredit ? 'text-success' : 'text-danger'} fs-6">${isCredit ? '+' : '-'}৳${Number(t.amount).toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                <td class="text-muted small">${t.timestamp}</td>
                <td class="small text-secondary">${t.relatedAccountId ? 'Acc #' + t.relatedAccountId : 'Branch / Counter'}</td>
            </tr>`;
        });
        tbody.innerHTML = html;
    }
    function renderRiskEvents(riskEvents) {
        const tbody = document.getElementById('udRiskTableBody');
        if (!tbody) return;
        if (!riskEvents || riskEvents.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="text-center text-muted py-3"><i class="bi bi-shield-check fs-5 d-block text-secondary mb-1"></i>No risk events logged for this account.</td></tr>`;
            return;
        }

        let html = '';
        riskEvents.forEach(r => {
            let ptsStyle = r.points > 0 
                ? 'color: #f87171; font-weight: 700;' 
                : (r.points < 0 ? 'color: #4ade80; font-weight: 700;' : 'color: #94a3b8;');
            let ptsPrefix = r.points > 0 ? '+' : '';
            
            let eventBadge = '';
            if (r.eventType === 'Decay' || r.isDecay) {
                eventBadge = '<span class="badge rounded-pill px-3 py-1 small fw-bold" style="background: rgba(14, 165, 233, 0.2); color: #38bdf8; border: 1px solid #0ea5e9;"><i class="bi bi-clock-history me-1"></i>System Auto-Decay</span>';
            } else if (r.points > 0) {
                eventBadge = `<span class="fw-semibold text-white me-1.5">${r.eventType}</span><span class="badge rounded-pill px-2.5 py-1 small fw-bold" style="background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid #ef4444;">Risk Penalty</span>`;
            } else {
                eventBadge = `<span class="fw-semibold text-white me-1.5">${r.eventType}</span><span class="badge rounded-pill px-2.5 py-1 small fw-bold" style="background: rgba(34, 197, 94, 0.2); color: #86efac; border: 1px solid #22c55e;">Risk Reward</span>`;
            }

            html += `<tr>
                <td class="text-muted small">${r.timestamp}</td>
                <td>${eventBadge}</td>
                <td style="${ptsStyle}">${ptsPrefix}${r.points} pts</td>
                <td class="font-monospace fw-bold" style="color: #38bdf8;">${r.scoreAfter} pts</td>
            </tr>`;
        });
        tbody.innerHTML = html;
    }

    function openManualAdjustRiskModal() {
        if (currentViewingUserId <= 0) return;

        document.getElementById('adjustRiskUserId').value = currentViewingUserId;
        const name = document.getElementById('udModalFullName')?.innerText || 'User';
        const scoreText = document.getElementById('udModalRiskScoreVal')?.innerText || '0 pts';
        
        document.getElementById('adjustRiskUserName').innerText = name;
        document.getElementById('adjustRiskCurrentScore').innerText = scoreText;
        document.getElementById('adjustRiskPointsInput').value = '';
        document.getElementById('adjustRiskReasonInput').value = '';

        const modalEl = document.getElementById('adjustRiskScoreModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function setRiskAdjustmentPreset(val) {
        document.getElementById('adjustRiskPointsInput').value = val;
    }

    function filterUserTransactions(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#udTxTableBody tr');
        rows.forEach(r => {
            const text = r.innerText.toLowerCase();
            r.style.display = text.includes(q) ? '' : 'none';
        });
    }

    function setDepositPreset(val) {
        document.getElementById('udDepositAmount').value = Number(val).toFixed(2);
    }

    function submitAdminDepositFromModal() {
        if (currentViewingUserId <= 0) return;
        const amtInput = document.getElementById('udDepositAmount');
        const refInput = document.getElementById('udDepositRef');
        const btn = document.getElementById('udBtnDeposit');
        const alertDiv = document.getElementById('udDepositAlert');

        const amount = parseFloat(amtInput.value);
        if (isNaN(amount) || amount <= 0) {
            alertDiv.className = 'alert alert-danger small py-2 px-3 mb-2';
            alertDiv.innerText = 'Please enter a valid deposit amount greater than zero.';
            return;
        }

        const ref = refInput.value.trim();
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Processing...`;

        fetch('/Admin/AdminDepositFunds', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                userId: currentViewingUserId,
                amount: amount,
                reference: ref
            })
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-plus-circle-fill me-1"></i> Add Funds Now`;

            if (data.success) {
                alertDiv.className = 'alert alert-success small py-2 px-3 mb-2';
                alertDiv.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> ${data.message}`;
                amtInput.value = '';
                refInput.value = '';

                // Immediately reload user details & ledger
                openUserDetailsModal(currentViewingUserId);
            } else {
                alertDiv.className = 'alert alert-danger small py-2 px-3 mb-2';
                alertDiv.innerText = data.message || 'Failed to deposit funds.';
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-plus-circle-fill me-1"></i> Add Funds Now`;
            alertDiv.className = 'alert alert-danger small py-2 px-3 mb-2';
            alertDiv.innerText = 'Network error during deposit.';
        });
    }

    function openEditUserModal(id, fullName, username, email, phone, nid, role, status, accNumber, isActive) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editFullName').value = fullName;
        document.getElementById('editUsername').value = username;
        document.getElementById('editEmail').value = email;
        document.getElementById('editPhoneNumber').value = phone;
        document.getElementById('editNidNumber').value = nid;
        document.getElementById('editRole').value = role;
        document.getElementById('editStatus').value = status;
        document.getElementById('editAccountNumber').value = accNumber;

        if (editModalInstance) editModalInstance.show();
    }

    function openDeleteModal(id, fullName, username, role, nid, accNumber, balance) {
        document.getElementById('confirmedDeleteUserId').value = id;
        document.getElementById('delModalFullName').innerText = fullName;
        document.getElementById('delModalUsername').innerText = '@@' + username;
        document.getElementById('delModalRole').innerText = role + ' Account';
        document.getElementById('delModalNid').innerText = nid && nid.trim() !== '' ? nid : 'Not Provided';
        document.getElementById('delModalAcc').innerText = accNumber && accNumber.trim() !== '' ? accNumber + ' (৳' + Number(balance).toLocaleString('en-US', { minimumFractionDigits: 2 }) + ')' : 'No Active Account';
        document.getElementById('delModalAvatar').innerText = fullName.length > 0 ? fullName.substring(0, 1).toUpperCase() : 'U';

        if (deleteModalInstance) {
            deleteModalInstance.show();
        }
    }

    function triggerDeleteFromEdit() {
        const id = document.getElementById('editUserId').value;
        const fullName = document.getElementById('editFullName').value;
        const username = document.getElementById('editUsername').value;
        const role = document.getElementById('editRole').value;
        const nid = document.getElementById('editNidNumber').value;
        const accNumber = document.getElementById('editAccountNumber')?.value || '';
        const balance = 0;

        if (editModalInstance) editModalInstance.hide();
        setTimeout(() => {
            openDeleteModal(id, fullName, username, role, nid, accNumber, balance);
        }, 300);
    }

    function openSuspendModal(id, fullName, isCurrentlySuspended) {
        const uIdEl = document.getElementById('suspendUserId');
        if (uIdEl) uIdEl.value = id;
        const nameEl = document.getElementById('suspendUserName');
        if (nameEl) nameEl.innerText = fullName;
        const selectEl = document.getElementById('selectSuspendType');
        if (selectEl) {
            selectEl.value = isCurrentlySuspended ? 'Lift' : '1Hour';
        }
        const modalEl = document.getElementById('suspendModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function openCreateAccountModal(id, fullName) {
        const uIdEl = document.getElementById('accUserId');
        if (uIdEl) uIdEl.value = id;
        const nameEl = document.getElementById('accUserName');
        if (nameEl) nameEl.innerText = fullName;
        const modalEl = document.getElementById('createAccountModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function toggleInitialBalance(role) {
        const balInput = document.getElementById('initialBalanceInput');
        if (!balInput) return;
        if (role === 'Admin') {
            balInput.value = '0.00';
            balInput.setAttribute('readonly', 'readonly');
        } else {
            balInput.value = '1000.00';
            balInput.removeAttribute('readonly');
        }
    }

    function openOverrideVaultModal(id, fullName) {
        const uIdEl = document.getElementById('overrideVaultUserId');
        if (uIdEl) uIdEl.value = id;
        const nameEl = document.getElementById('overrideVaultUserName');
        if (nameEl) nameEl.innerText = fullName;
        const modalEl = document.getElementById('overrideVaultModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }
    }
</script>
}