<!-- Modal 5: Platform Audit Log -->
<div class="modal fade" id="auditLogModal" tabindex="-1" aria-labelledby="auditLogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="auditLogModalLabel">
                    <i class="bi bi-journal-text text-primary me-2"></i> Platform Audit Log
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive" style="max-height: 500px;">
                    <table class="table sb-table mb-0">
                        <thead class="sticky-top bg-light">
                            <tr>
                                <th>Tx Ref</th>
                                <th>Account #</th>
                                <th>Type</th>
                                <th>Amount (৳)</th>
                                <th>Timestamp</th>
                                <th>Counterparty</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (auditTransactions != null && auditTransactions.Any())
                            {
                                @foreach (var tx in auditTransactions)
                                {
                                    var isCredit = tx.Type == SmartBank.Entities.TransactionType.Deposit || tx.Type == SmartBank.Entities.TransactionType.TransferIn;
                                    <tr>
                                        <td class="font-monospace fw-bold">#TX-@tx.Id.ToString("D6")</td>
                                        <td class="font-monospace">@(tx.Account?.AccountNumber ?? $"Acc #{tx.AccountId}")</td>
                                        <td>
                                            <span class="badge @(isCredit ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                @tx.Type.ToString()
                                            </span>
                                        </td>
                                        <td class="fw-bold @(isCredit ? "text-success" : "text-danger")">
                                            @(isCredit ? "+" : "-")৳@tx.Amount.ToString("N2")
                                        </td>
                                        <td class="text-muted small">@tx.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="small">@(tx.RelatedAccountId.HasValue ? $"Acc #{tx.RelatedAccountId.Value}" : "—")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No platform transactions logged yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let editModalInstance = null;
    let deleteModalInstance = null;

    document.addEventListener('DOMContentLoaded', () => {
        const editEl = document.getElementById('editUserModal');
        if (editEl) editModalInstance = new bootstrap.Modal(editEl);

        const delEl = document.getElementById('deleteUserModal');
        if (delEl) deleteModalInstance = new bootstrap.Modal(delEl);
    });

    function openEditUserModal(id, fullName, username, email, phone, nid, role, status, accNumber, balance, isActive) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editFullName').value = fullName;
        document.getElementById('editUsername').value = username;
        document.getElementById('editEmail').value = email;
        document.getElementById('editPhoneNumber').value = phone;
        document.getElementById('editNidNumber').value = nid;
        document.getElementById('editRole').value = role;
        document.getElementById('editStatus').value = status;
        document.getElementById('editAccountNumber').value = accNumber;
        document.getElementById('editBalance').value = balance;

        if (editModalInstance) editModalInstance.show();
    }

    function openDeleteModal(id, fullName, username, role, nid, accNumber, balance) {
        document.getElementById('confirmedDeleteUserId').value = id;
        document.getElementById('delModalFullName').innerText = fullName;
        document.getElementById('delModalUsername').innerText = '@@' + username;
        document.getElementById('delModalRole').innerText = role + ' Account';
        document.getElementById('delModalNid').innerText = nid && nid.trim() !== '' ? nid : 'Not Provided';
        document.getElementById('delModalAcc').innerText = accNumber && accNumber.trim() !== '' ? accNumber + ' (৳' + Number(balance).toLocaleString('en-US', { minimumFractionDigits: 2 }) + ')' : 'No Active Account';
        document.getElementById('delModalAvatar').innerText = fullName.length > 0 ? fullName.substring(0, 1).toUpperCase() : 'U';

        if (deleteModalInstance) {
            deleteModalInstance.show();
        }
    }

    function triggerDeleteFromEdit() {
        const id = document.getElementById('editUserId').value;
        const fullName = document.getElementById('editFullName').value;
        const username = document.getElementById('editUsername').value;
        const role = document.getElementById('editRole').value;
        const nid = document.getElementById('editNidNumber').value;
        const accNumber = document.getElementById('editAccountNumber').value;
        const balance = document.getElementById('editBalance').value;

        if (editModalInstance) editModalInstance.hide();
        setTimeout(() => {
            openDeleteModal(id, fullName, username, role, nid, accNumber, balance);
        }, 300);
    }

    function openSuspendModal(id, fullName, isCurrentlySuspended) {
        document.getElementById('suspendUserId').value = id;
        document.getElementById('suspendUserName').innerText = fullName;
        if (isCurrentlySuspended) {
            document.getElementById('selectSuspendType').value = 'Lift';
        } else {
            document.getElementById('selectSuspendType').value = '1Hour';
        }
        const modal = new bootstrap.Modal(document.getElementById('suspendModal'));
        modal.show();
    }

    function openCreateAccountModal(id, fullName) {
        document.getElementById('accUserId').value = id;
        document.getElementById('accUserName').innerText = fullName;
        const modal = new bootstrap.Modal(document.getElementById('createAccountModal'));
        modal.show();
    }

    function toggleInitialBalance(role) {
        const balInput = document.getElementById('initialBalanceInput');
        if (!balInput) return;
        if (role === 'Admin') {
            balInput.value = '0.00';
            balInput.setAttribute('readonly', 'readonly');
        } else {
            balInput.value = '1000.00';
            balInput.removeAttribute('readonly');
        }
    }
</script>
}