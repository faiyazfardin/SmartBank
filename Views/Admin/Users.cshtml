@model List<SmartBank.Entities.User>

@{
    ViewData["Title"] = "All Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>User Management</h2>
    <span class="badge bg-primary fs-6">Total Users: @Model.Count</span>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover mt-2 align-middle">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Account Number</th>
                <th>Balance</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var account = user.Accounts.FirstOrDefault();
                <tr>
                    <td><strong>@user.FullName</strong></td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td><span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-info")">@user.Role</span></td>
                    <td><code>@(account?.AccountNumber ?? "No account")</code></td>
                    <td>@(account != null ? account.Balance.ToString("C") : "-")</td>
                    <td>
                        @if (account != null)
                        {
                            <span class="badge @(account.IsActive ? "bg-success" : "bg-danger")">
                                @(account.IsActive ? "Active" : "Frozen")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No Account</span>
                        }
                    </td>

                    <td>
                        @if (account != null)
                        {
                            <form asp-controller="Admin" asp-action="ToggleAccountStatus" method="post" class="d-inline">
                                <input type="hidden" name="accountId" value="@account.Id" />
                                <button type="submit" class="btn btn-sm @(account.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(account.IsActive ? "Freeze Account" : "Activate Account")
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Admin" asp-action="CreateAccount" method="post" class="d-inline">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Create Account</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>